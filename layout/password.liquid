<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_paper }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    >
    <style>
      :root {
        --color-paper: {{ settings.color_paper.red }} {{ settings.color_paper.green }} {{ settings.color_paper.blue }};
        --color-ink: {{ settings.color_ink.red }} {{ settings.color_ink.green }} {{ settings.color_ink.blue }};
        --color-line: {{ settings.color_line.red }} {{ settings.color_line.green }} {{ settings.color_line.blue }};
        --color-sand: {{ settings.color_sand.red }} {{ settings.color_sand.green }} {{ settings.color_sand.blue }};
        --color-footer: {{ settings.color_footer.red }} {{ settings.color_footer.green }} {{ settings.color_footer.blue }};
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
