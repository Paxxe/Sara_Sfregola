{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&display=swap"
      rel="stylesheet"
    >
    <style>
      :root {
        --color-paper: {{ settings.color_paper.red }} {{ settings.color_paper.green }} {{ settings.color_paper.blue }};
        --color-ink: {{ settings.color_ink.red }} {{ settings.color_ink.green }} {{ settings.color_ink.blue }};
        --color-line: {{ settings.color_line.red }} {{ settings.color_line.green }} {{ settings.color_line.blue }};
        --color-sand: {{ settings.color_sand.red }} {{ settings.color_sand.green }} {{ settings.color_sand.blue }};
        --color-footer: {{ settings.color_footer.red }} {{ settings.color_footer.green }} {{ settings.color_footer.blue }};
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body class="bg-oat">
    <main class="flex min-h-[100svh] items-center justify-center px-[6%] py-[60px]">
      <div class="w-full max-w-[560px] bg-paper px-[8%] py-[55px] text-center print:shadow-none md:px-[60px]">
        <div class="mx-auto mb-[40px] w-[110px]">
          {%- render 'logo', class: 'block w-full brightness-0', text_class: 'items-center text-center text-[22px]', sizes: '110px' -%}
        </div>

        <p class="eyebrow mb-7">{{ 'gift_card.title' | t | upcase }}</p>
        <h1 class="text-[42px] leading-none md:text-[56px]">
          {{- gift_card.balance | money -}}
        </h1>
        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign initial_value = gift_card.initial_value | money -%}
          <p class="mt-3 text-[11px] text-muted">{{ 'gift_card.initial_value' | t: value: initial_value }}</p>
        {%- endif -%}

        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="mt-5 text-[11px] text-[#8a2a1a]">{{ 'gift_card.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expiry = gift_card.expires_on | date: '%d/%m/%Y' -%}
          <p class="mt-5 text-[11px] text-muted">{{ 'gift_card.expires_on' | t: date: expiry }}</p>
        {%- endif -%}

        <div class="mx-auto mt-[35px] flex w-fit flex-col items-center gap-5">
          <div id="GiftCardQr" class="bg-paper p-2" data-identifier="{{ gift_card.qr_identifier }}"></div>
          <p class="rounded-full border border-pill px-6 py-3 text-[13px] tracking-[2px]" aria-label="{{ 'gift_card.code' | t }}">
            {{- gift_card.code | format_code -}}
          </p>
        </div>

        <div class="mt-[35px] flex flex-wrap justify-center gap-3 print:hidden">
          <a href="{{ shop.url }}" class="btn-solid">{{ 'gift_card.shop' | t }} ↗</a>
          <button type="button" class="line-link" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}" class="line-link">Apple Wallet</a>
          {%- endif -%}
        </div>
      </div>
    </main>

    <script>
      window.addEventListener('load', () => {
        const el = document.getElementById('GiftCardQr');
        if (el && window.QRCode) {
          new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120, colorDark: '#292820', colorLight: '#f8f5ee' });
        }
      });
    </script>
  </body>
</html>
