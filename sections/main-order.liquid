{%- liquid
  assign order_date = order.created_at | time_tag: format: 'date'
  assign heading_eyebrow = 'customer.order' | t | upcase
-%}
{%- render 'page-heading', eyebrow: heading_eyebrow, title: order.name, text: order_date, align: 'left' -%}

<div class="grid grid-cols-1 gap-[45px] px-[7%] pb-20 md:grid-cols-[1.6fr_1fr] md:gap-[8%] md:px-[4%] md:pb-[130px]">
  <section>
    {%- if order.cancelled -%}
      {%- assign cancelled_date = order.cancelled_at | date: '%d/%m/%Y' -%}
      <p class="mb-6 bg-sand p-5 text-[12px]">{{ 'customer.cancelled' | t: date: cancelled_date }}</p>
    {%- endif -%}

    <ul class="border-t border-line">
      {%- for line_item in order.line_items -%}
        <li class="grid grid-cols-[80px_1fr_auto] gap-5 border-b border-line py-5">
          <div class="aspect-[3/4] overflow-hidden bg-mist">
            {%- if line_item.image -%}
              {{ line_item.image | image_url: width: 300 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy' }}
            {%- endif -%}
          </div>
          <div class="text-[12px]">
            {%- if line_item.url != blank -%}
              <a href="{{ line_item.url }}">{{ line_item.title }}</a>
            {%- else -%}
              {{ line_item.title }}
            {%- endif -%}
            <p class="mt-2 text-[11px] text-muted">{{ 'cart.quantity' | t }}: {{ line_item.quantity }}</p>
            {%- if line_item.fulfillment -%}
              <p class="mt-1 text-[11px] text-muted">
                {{ 'customer.shipped' | t }} {{ line_item.fulfillment.created_at | date: '%d/%m/%Y' }}
                {%- if line_item.fulfillment.tracking_url %}
                  · <a href="{{ line_item.fulfillment.tracking_url }}" class="underline underline-offset-4">{{ 'customer.tracking' | t }}</a>
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
          <span class="text-[12px]">{{ line_item.final_line_price | money }}</span>
        </li>
      {%- endfor -%}
    </ul>

    <dl class="ml-auto mt-6 max-w-[360px] text-[12px]">
      <div class="flex justify-between py-2"><dt class="text-muted">{{ 'cart.subtotal' | t }}</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>
      {%- for discount in order.cart_level_discount_applications -%}
        <div class="flex justify-between py-2"><dt class="text-muted">{{ discount.title }}</dt><dd>−{{ discount.total_allocated_amount | money }}</dd></div>
      {%- endfor -%}
      {%- for shipping_method in order.shipping_methods -%}
        <div class="flex justify-between py-2"><dt class="text-muted">{{ shipping_method.title }}</dt><dd>{{ shipping_method.price | money }}</dd></div>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <div class="flex justify-between py-2"><dt class="text-muted">{{ tax_line.title }} {{ tax_line.rate_percentage }}%</dt><dd>{{ tax_line.price | money }}</dd></div>
      {%- endfor -%}
      <div class="flex justify-between border-t border-line py-3 text-[13px]"><dt>{{ 'cart.total' | t }}</dt><dd>{{ order.total_net_amount | money_with_currency }}</dd></div>
    </dl>
  </section>

  <aside class="space-y-6 md:self-start">
    <div class="bg-oat p-[30px]">
      <p class="eyebrow mb-4">{{ 'customer.status' | t }}</p>
      <p class="text-[12px]">{{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
    </div>
    {%- if order.shipping_address -%}
      <div class="bg-oat p-[30px]">
        <p class="eyebrow mb-4">{{ 'customer.shipping_address' | t }}</p>
        <div class="text-[11px] leading-[1.8] text-ink-soft">{{ order.shipping_address | format_address }}</div>
      </div>
    {%- endif -%}
    {%- if order.billing_address -%}
      <div class="bg-oat p-[30px]">
        <p class="eyebrow mb-4">{{ 'customer.billing_address' | t }}</p>
        <div class="text-[11px] leading-[1.8] text-ink-soft">{{ order.billing_address | format_address }}</div>
      </div>
    {%- endif -%}
    <a href="{{ routes.account_url }}" class="line-link">← {{ 'customer.back_to_account' | t }}</a>
  </aside>
</div>

{% schema %}
{
  "name": "Dettaglio ordine",
  "tag": "div",
  "settings": []
}
{% endschema %}
