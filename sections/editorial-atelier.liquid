{%- assign is_territory = false -%}
{%- if section.settings.layout == 'territory' -%}{%- assign is_territory = true -%}{%- endif -%}

<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  {% if is_territory %}
    class="territory"
  {% else %}
    class="grid grid-cols-1 items-center gap-[15px] px-[8%] py-[85px] md:grid-cols-2 md:gap-[15%] md:px-[9%] md:py-[155px]"
  {% endif %}
>
  <div class="min-w-0">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow mb-[27px]">
        {%- if section.settings.number != blank -%}
          {{ section.settings.number }} /
        {% endif -%}
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}
    <h2 class="{% if is_territory %}territory__title{% else %}mb-[30px] text-[34px] md:text-[42px]{% endif %}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte {% if is_territory %}territory__text{% else %}max-w-[420px] leading-[1.9] text-[#6d695f]{% endif %}">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <figure class="{% if is_territory %}territory__figure{% else %}m-0 pt-[25px] md:pt-[75px]{% endif %}">
    <div class="{% if is_territory %}territory__image{% else %}h-[400px] overflow-hidden md:h-[540px]{% endif %}">
      {%- render 'media',
        image: section.settings.image,
        placeholder: 'lifestyle-2',
        class: 'h-full w-full object-cover object-[center_64%]',
        sizes: '(min-width: 721px) 50vw, 100vw'
      -%}
    </div>
    {%- if section.settings.caption != blank -%}
      <figcaption class="mt-4 text-[8px] uppercase tracking-[2px]">{{ section.settings.caption }}</figcaption>
    {%- endif -%}
  </figure>
</section>

{% schema %}
{
  "name": "L’Atelier",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "atelier"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "04"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "L’ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "The Atelier"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Didascalia",
      "default": "IMMAGINE"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Stile",
      "options": [
        { "value": "default", "label": "Classico" },
        { "value": "territory", "label": "Territorio (titolo grande, fondo sabbia)" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "L’Atelier",
      "category": "Editoriale"
    }
  ]
}
{% endschema %}
