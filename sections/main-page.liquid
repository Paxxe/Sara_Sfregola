{%- render 'page-heading', eyebrow: section.settings.eyebrow, title: page.title, italic: section.settings.italic -%}

<div class="px-[7%] pb-20 md:px-[4%] md:pb-[130px]">
  <div class="rte mx-auto {{ section.settings.width }} text-[13px] leading-[1.95] text-ink-soft [&_h2]:mb-4 [&_h2]:mt-12 [&_h2]:text-[26px] [&_h2]:text-ink [&_h3]:mb-3 [&_h3]:mt-8 [&_h3]:text-[15px] [&_h3]:text-ink [&_img]:my-10 [&_li]:ml-5 [&_ol]:list-decimal [&_ul]:list-disc">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Pagina",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "SARA SFREGOLA"
    },
    {
      "type": "text",
      "id": "italic",
      "label": "Seconda riga titolo (corsivo)"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Larghezza testo",
      "options": [
        { "value": "max-w-[620px]", "label": "Stretta" },
        { "value": "max-w-[820px]", "label": "Media" },
        { "value": "max-w-[1100px]", "label": "Ampia" }
      ],
      "default": "max-w-[620px]"
    }
  ]
}
{% endschema %}
