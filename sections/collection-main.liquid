{%- comment -%}
  PLP — pagina collezione (creazioni.html + catalogue.css + catalogue-filter.js).
  Intestazione con categorie e descrizione in Cormorant, barra con conteggio / filtri /
  "Ordina per", griglia a 4 colonne con immagine editoriale inserita, consulenza finale.
{%- endcomment -%}
{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign filters_id = 'Filters-' | append: section.id

  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  assign tabs_filter = nil
  if section.settings.tabs_menu == blank and section.settings.tabs_filter_label != blank
    for filter in collection.filters
      if filter.label == section.settings.tabs_filter_label and filter.type == 'list'
        assign tabs_filter = filter
        break
      endif
    endfor
  endif
-%}

<div class="font-manrope">
  {%- comment -%} ===================== Intestazione ===================== {%- endcomment -%}
  <section class="px-4 pb-[25px] pt-10 md:px-6 md:pb-[30px] md:pt-[65px]">
    <p class="mb-[25px] text-[12px] text-[#736f64]">
      <a href="{{ routes.root_url }}">{{ 'collections.home_label' | t }}</a>
      / {{ section.settings.breadcrumb_label }}
    </p>
    <h1 class="font-manrope text-[clamp(28px,3vw,44px)] font-normal leading-[1.2] tracking-[-1px]">{{ collection.title }}</h1>

    {%- comment -%} Categorie {%- endcomment -%}
    <nav class="mt-7 flex flex-wrap gap-x-5 gap-y-[13px] text-[13px] md:gap-x-[30px] md:gap-y-[14px] md:text-[14px]" aria-label="{{ 'collections.categories' | t }}">
      {%- if section.settings.tabs_menu != blank -%}
        {%- for link in section.settings.tabs_menu.links -%}
          <a
            href="{{ link.url }}"
            class="border-b pb-[5px]{% if link.current or link.active %} border-ink{% else %} border-transparent{% endif %}"
            {% if link.current or link.active %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title -}}
          </a>
        {%- endfor -%}
      {%- elsif tabs_filter -%}
        <a
          href="{{ collection.url }}?sort_by={{ sort_by }}"
          class="border-b pb-[5px]{% if tabs_filter.active_values.size == 0 %} border-ink{% else %} border-transparent{% endif %}"
          {% if tabs_filter.active_values.size == 0 %}
            aria-current="page"
          {% endif %}
        >
          {{- section.settings.all_label -}}
        </a>
        {%- for value in tabs_filter.values -%}
          {%- if value.count > 0 or value.active -%}
            <a
              href="{{ collection.url }}?{{ value.param_name }}={{ value.value | url_encode }}&sort_by={{ sort_by }}"
              class="border-b pb-[5px]{% if value.active %} border-ink{% else %} border-transparent{% endif %}"
              {% if value.active %}
                aria-current="page"
              {% endif %}
            >
              {{- value.label -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>

    {%- if section.settings.show_description -%}
      {%- assign description = collection.description | default: section.settings.fallback_description -%}
      {%- if description != blank -%}
        <div class="mt-[26px] max-w-[640px] font-serif text-[21px] leading-[1.45] md:text-[22px] [&_p]:m-0">
          {{ description }}
        </div>
      {%- endif -%}
    {%- endif -%}
  </section>

  {%- comment -%} ===================== Catalogo ===================== {%- endcomment -%}
  <section class="px-2 pb-10 md:px-3 md:pb-[70px]" aria-label="{{ 'collections.catalogue' | t }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- comment -%} Barra: conteggio, filtri, ordinamento {%- endcomment -%}
      <div class="flex flex-wrap items-center gap-[15px] px-2 pb-[22px] pt-[10px] text-[14px] md:flex-nowrap md:gap-[25px] md:px-3 md:pt-[15px]">
        {%- if section.settings.enable_filters and collection.filters.size > 0 -%}
          <details class="relative z-[5]" data-filter-dropdown>
            <summary class="cursor-pointer">
              {{- 'collections.filter' | t -}}
              {%- if active_count > 0 %} ({{ active_count }}){% endif -%}
              <span class="ml-3 text-[16px]" aria-hidden="true">+</span>
            </summary>
            <form
              action="{{ collection.url }}"
              method="get"
              id="{{ filters_id }}"
              class="absolute left-0 top-[35px] grid max-h-[70vh] w-[260px] gap-[15px] overflow-y-auto bg-paper p-6 shadow-[0_6px_24px_#27261f18] md:w-[275px]"
            >
              <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
              {%- for filter in collection.filters -%}
                <fieldset class="m-0 border-0 border-b border-line p-0 pb-[15px]">
                  <legend class="mb-3 text-[12px] uppercase tracking-[1px] text-[#736f64]">{{ filter.label }}</legend>
                  {%- case filter.type -%}
                    {%- when 'list', 'boolean' -%}
                      <div class="grid gap-[10px]">
                        {%- for value in filter.values -%}
                          {%- if value.count > 0 or value.active -%}
                            <label class="flex cursor-pointer items-center gap-3 text-[13px]">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value | escape }}"
                                class="h-3 w-3 accent-ink"
                                {% if value.active %}
                                  checked
                                {% endif %}
                              >
                              <span>{{ value.label }}</span>
                              <span class="ml-auto text-[11px] text-[#736f64]">{{ value.count }}</span>
                            </label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- when 'price_range' -%}
                      <div class="grid grid-cols-2 gap-3">
                        <input
                          class="w-full border-0 border-b border-line bg-transparent p-2 text-[13px] focus:outline-none"
                          type="number"
                          min="0"
                          step="any"
                          inputmode="decimal"
                          name="{{ filter.min_value.param_name }}"
                          placeholder="{{ 'collections.price_from' | t }}"
                          aria-label="{{ 'collections.price_from' | t }}"
                          {% if filter.min_value.value %}
                            value="{{ filter.min_value.value | divided_by: 100.0 }}"
                          {% endif %}
                        >
                        <input
                          class="w-full border-0 border-b border-line bg-transparent p-2 text-[13px] focus:outline-none"
                          type="number"
                          min="0"
                          step="any"
                          inputmode="decimal"
                          name="{{ filter.max_value.param_name }}"
                          placeholder="{{ 'collections.price_to' | t }}"
                          aria-label="{{ 'collections.price_to' | t }}"
                          {% if filter.max_value.value %}
                            value="{{ filter.max_value.value | divided_by: 100.0 }}"
                          {% endif %}
                        >
                      </div>
                  {%- endcase -%}
                </fieldset>
              {%- endfor -%}
              <div class="flex items-center justify-between gap-4">
                <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="text-[12px] underline underline-offset-2">{{ 'collections.clear_all' | t }}</a>
                <button type="submit" class="rounded-full bg-ink px-5 py-[10px] text-[12px] text-paper">{{ 'collections.apply' | t }}</button>
              </div>
            </form>
          </details>
        {%- endif -%}

        <span class="ml-auto text-[12px] text-[#736f64] md:ml-0" aria-live="polite">
          {{ 'collections.count' | t: count: collection.products_count }}
        </span>

        {%- if section.settings.enable_sort -%}
          <label class="flex w-full items-center justify-between gap-3 text-[12px] md:ml-auto md:w-auto md:justify-start md:text-[14px]">
            {{ 'collections.sort_by' | t }}
            <select class="cursor-pointer border-0 bg-transparent p-2 font-manrope text-[inherit] focus:outline-none" data-sort-select>
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value | escape }}"
                  {% if option.value == sort_by %}
                    selected
                  {% endif %}
                >
                  {{- option.name -}}
                </option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
      </div>

      {%- comment -%} Griglia {%- endcomment -%}
      {%- liquid
        assign page_count = collection.products.size
        if page_count >= 8
          assign insert_after = 4
          assign editorial_class = 'md:col-start-3 md:col-span-2 md:row-start-2 md:row-span-2 md:aspect-auto md:min-h-full'
        elsif page_count >= 3
          assign insert_after = 2
          assign editorial_class = 'md:col-start-3 md:col-span-2 md:row-start-1 md:row-span-2 md:aspect-auto md:min-h-full'
        else
          assign insert_after = page_count
          assign editorial_class = 'md:col-start-3 md:col-span-2 md:row-start-1 md:aspect-[3/4]'
        endif

        assign show_editorial = false
        if section.settings.show_editorial and paginate.current_page == 1
          if section.settings.editorial_image != blank or request.design_mode
            assign show_editorial = true
          endif
        endif
      -%}

      {%- if page_count > 0 -%}
        <div class="grid grid-cols-2 items-start gap-x-2 gap-y-[30px] md:grid-cols-4 md:gap-y-[38px]">
          {%- for product in collection.products -%}
            {%- liquid
              assign card_loading = 'lazy'
              if forloop.index <= 4
                assign card_loading = 'eager'
              endif
            -%}
            {%- render 'plp-card',
              product: product,
              caption_source: section.settings.caption_source,
              caption_key: section.settings.caption_metafield,
              caption_fallback: section.settings.caption_fallback,
              show_badges: section.settings.show_badges,
              loading: card_loading
            -%}

            {%- if show_editorial and forloop.index == insert_after -%}
              <figure class="relative col-span-2 m-0 aspect-[4/3] self-stretch overflow-hidden bg-sand {{ editorial_class }}">
                {%- render 'media',
                  image: section.settings.editorial_image,
                  placeholder: 'lifestyle-2',
                  class: 'absolute inset-0 h-full w-full object-cover',
                  sizes: '(min-width: 721px) 50vw, 100vw'
                -%}
                {%- if section.settings.editorial_caption != blank -%}
                  <figcaption class="absolute bottom-6 left-[25px] right-[25px] font-serif text-[23px] italic leading-[1.2] text-white [text-shadow:0_1px_8px_#0008] lg:text-[28px]">
                    {{ section.settings.editorial_caption }}
                  </figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <div class="px-5 py-10">
          <p class="text-[14px]">{{ 'collections.empty' | t }}</p>
          {%- if active_count > 0 -%}
            <a href="{{ collection.url }}" class="mt-3 inline-block text-[14px] underline">{{ 'collections.clear_all' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </section>

  {%- comment -%} ===================== Consulenza ===================== {%- endcomment -%}
  {%- if section.settings.show_consult -%}
    <section class="bg-sand px-5 pb-[55px] pt-[55px] text-center md:px-6 md:pb-[100px] md:pt-[65px]">
      {%- if section.settings.consult_eyebrow != blank -%}
        <p class="eyebrow mb-[27px]">{{ section.settings.consult_eyebrow }}</p>
      {%- endif -%}
      <h2 class="font-manrope text-[clamp(35px,4vw,60px)] leading-[1.1] tracking-[-1px]">
        {{- section.settings.consult_heading }}
        {% if section.settings.consult_italic != blank %}<em class="text-[1.2em] leading-none">{{ section.settings.consult_italic }}</em>{% endif -%}
      </h2>
      {%- if section.settings.consult_text != blank -%}
        <p class="mx-auto my-6 max-w-[550px] text-[16px] leading-[1.9]">{{ section.settings.consult_text }}</p>
      {%- endif -%}
      {%- if section.settings.consult_label != blank -%}
        <a class="line-link text-[14px]" href="{{ section.settings.consult_url | default: routes.root_url }}">{{ section.settings.consult_label }}</a>
      {%- endif -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Pagina collezione",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "header",
      "content": "Intestazione"
    },
    {
      "type": "text",
      "id": "breadcrumb_label",
      "label": "Percorso (dopo Home)",
      "default": "Creazioni"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostra descrizione collezione",
      "default": true
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Descrizione se la collezione non ne ha",
      "default": "Abiti, corsetti e accessori in cui il gesto artigianale incontra la forma contemporanea. Scopri le creazioni di Sara Sfregola."
    },
    {
      "type": "header",
      "content": "Categorie"
    },
    {
      "type": "link_list",
      "id": "tabs_menu",
      "label": "Menu categorie",
      "info": "Es. Tutte le creazioni / Heritage / Collezione Africa / Abiti… (link alle collezioni). Ha la precedenza sul filtro."
    },
    {
      "type": "text",
      "id": "tabs_filter_label",
      "label": "Oppure: nome del filtro da usare come categorie",
      "default": "Tipo di prodotto"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Etichetta \"tutte\"",
      "default": "Tutte le creazioni"
    },
    {
      "type": "header",
      "content": "Griglia"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Prodotti per pagina",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "caption_source",
      "label": "Testo sotto il nome",
      "options": [
        { "value": "metafield", "label": "Didascalia (metafield)" },
        { "value": "price", "label": "Prezzo" }
      ],
      "default": "metafield"
    },
    {
      "type": "text",
      "id": "caption_metafield",
      "label": "Metafield didascalia",
      "default": "custom.didascalia"
    },
    {
      "type": "text",
      "id": "caption_fallback",
      "label": "Didascalia se vuota",
      "default": "Creazione d’atelier"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Etichette (esaurito / pezzo unico)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Filtri",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sort",
      "label": "Ordina per",
      "default": true
    },
    {
      "type": "header",
      "content": "Immagine editoriale"
    },
    {
      "type": "checkbox",
      "id": "show_editorial",
      "label": "Mostra immagine nella griglia",
      "default": true,
      "info": "Occupa 2×2 card, dopo il 4° prodotto (o il 2° con pochi prodotti). Solo prima pagina."
    },
    {
      "type": "image_picker",
      "id": "editorial_image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "editorial_caption",
      "label": "Didascalia (corsivo)"
    },
    {
      "type": "header",
      "content": "Consulenza"
    },
    {
      "type": "checkbox",
      "id": "show_consult",
      "label": "Mostra consulenza in fondo",
      "default": true
    },
    {
      "type": "text",
      "id": "consult_eyebrow",
      "label": "Sopratitolo",
      "default": "UN INCONTRO, UN’IDEA, LA TUA CREAZIONE"
    },
    {
      "type": "text",
      "id": "consult_heading",
      "label": "Titolo",
      "default": "Da immaginare"
    },
    {
      "type": "text",
      "id": "consult_italic",
      "label": "Titolo (corsivo)",
      "default": "insieme."
    },
    {
      "type": "textarea",
      "id": "consult_text",
      "label": "Testo",
      "default": "Una forma, una lavorazione, un dettaglio che ti somiglia. Sara ti accompagna nella scelta e nella realizzazione del tuo capo."
    },
    {
      "type": "text",
      "id": "consult_label",
      "label": "Testo pulsante",
      "default": "Richiedi una consulenza privata"
    },
    {
      "type": "url",
      "id": "consult_url",
      "label": "Link pulsante"
    }
  ]
}
{% endschema %}
