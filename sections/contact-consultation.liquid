{%- liquid
  assign dialog_id = 'ConsultDialog-' | append: section.id
  assign form_id = 'ConsultForm-' | append: section.id
-%}

<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="bg-oat px-[8%] py-20 text-center md:px-5 md:py-[120px]"
>
  <p class="eyebrow mb-[27px]">
    {%- if section.settings.number != blank -%}
      {{ section.settings.number }} /
    {% endif -%}
    {{ section.settings.eyebrow }}
  </p>
  <h2 class="text-[32px] md:text-[42px]">{{ section.settings.heading }}</h2>
  {%- if section.settings.text != blank -%}
    <div class="rte mx-auto my-7 max-w-[490px] leading-[1.9]">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- if section.settings.button_mode == 'link' and section.settings.button_url != blank -%}
    <a class="btn-solid mt-7" href="{{ section.settings.button_url }}">{{ section.settings.button_label }} ↗</a>
  {%- else -%}
    <button type="button" class="btn-solid mt-7" data-dialog-open="{{ dialog_id }}" aria-haspopup="dialog">
      {{- section.settings.button_label }} ↗
    </button>
  {%- endif -%}
</section>

{%- unless section.settings.button_mode == 'link' and section.settings.button_url != blank -%}
  <dialog
    id="{{ dialog_id }}"
    class="m-auto max-h-[90svh] w-[min(860px,94vw)] overflow-y-auto border-0 bg-paper px-[23px] py-[45px] text-ink md:p-[55px]"
    aria-labelledby="{{ dialog_id }}-title"
  >
    <button
      type="button"
      class="absolute right-[18px] top-3 text-[30px]"
      aria-label="{{ 'general.close' | t }}"
      data-dialog-close
    >
      ×
    </button>

    <h2 id="{{ dialog_id }}-title" class="mb-6 text-[32px] md:text-[43px]">{{ section.settings.form_heading }}</h2>

    {%- form 'contact', id: form_id -%}
      {%- if form.posted_successfully? -%}
        <p class="mt-5 whitespace-pre-line bg-sand p-5" role="status" data-form-status>
          {{ section.settings.success_message }}
        </p>
      {%- elsif form.errors -%}
        <div class="mt-5 bg-sand p-5 text-[#8a2a1a]" role="alert" data-form-status>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Origine]" value="Consulenza privata — Home page">

      <div class="grid grid-cols-1 gap-x-8 md:grid-cols-2">
        <label>
          <span class="field-label">{{ 'contact.name' | t }}</span>
          <input class="field" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
        </label>
        <label>
          <span class="field-label">{{ 'contact.email' | t }}</span>
          <input
            class="field"
            type="email"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            value="{{ form.email }}"
            required
          >
        </label>
        <label>
          <span class="field-label">{{ 'contact.phone' | t }}</span>
          <input class="field" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
        </label>
        <label>
          <span class="field-label">{{ 'contact.event_date' | t }}</span>
          <input class="field" type="date" name="contact[Data evento]">
        </label>
      </div>

      {%- assign request_types = section.settings.request_types | split: ',' -%}
      {%- if request_types.size > 0 -%}
        <label>
          <span class="field-label">{{ 'contact.request_type' | t }}</span>
          <select class="field" name="contact[Tipo di richiesta]">
            {%- for type in request_types -%}
              <option value="{{ type | strip | escape }}">{{ type | strip }}</option>
            {%- endfor -%}
          </select>
        </label>
      {%- endif -%}

      <label>
        <span class="field-label">{{ 'contact.message' | t }}</span>
        <textarea class="field min-h-[90px]" name="contact[body]" rows="4">{{ form.body }}</textarea>
      </label>

      <button type="submit" class="btn-solid mt-5">{{ section.settings.submit_label }} ↗</button>
    {%- endform -%}
  </dialog>
{%- endunless -%}

{% schema %}
{
  "name": "Contatti · Consulenza privata",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "consulenza"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "05"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "PRIVATE APPOINTMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Consulenza privata"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante",
      "default": "Prepara la tua richiesta"
    },
    {
      "type": "select",
      "id": "button_mode",
      "label": "Azione pulsante",
      "options": [
        {
          "value": "dialog",
          "label": "Apri modulo in finestra"
        },
        {
          "value": "link",
          "label": "Vai a una pagina"
        }
      ],
      "default": "dialog"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Pagina di destinazione",
      "info": "Usata con \"Vai a una pagina\" (es. pagina consulenza privata)."
    },
    {
      "type": "header",
      "content": "Modulo"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Titolo modulo",
      "default": "Prepara la tua richiesta"
    },
    {
      "type": "text",
      "id": "request_types",
      "label": "Tipi di richiesta",
      "default": "Abito da sposa, Abito da cerimonia, Couture su misura, Accessori, Altro",
      "info": "Separati da virgola"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Testo invio",
      "default": "Invia la richiesta"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Messaggio di conferma",
      "default": "Grazie, la tua richiesta è stata inviata. Ti ricontatteremo al più presto."
    }
  ],
  "presets": [
    {
      "name": "Consulenza privata",
      "category": "Contatti e assistenza"
    }
  ]
}
{% endschema %}
