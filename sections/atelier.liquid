<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="page-width section-y border-t border-ink/10"
>
  <div class="mb-12 grid gap-8 md:mb-16 md:grid-cols-2 md:items-end">
    <div>
      <p class="eyebrow mb-6 text-stone">
        {%- if section.settings.number != blank -%}
          {{ section.settings.number }} /
        {% endif -%}
        {{ section.settings.eyebrow }}
      </p>
      <h2 class="display-lg">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.text != blank -%}
      <div class="rte max-w-md text-base leading-relaxed text-ink/75 md:justify-self-end">
        {{ section.settings.text }}
      </div>
    {%- endif -%}
  </div>

  <figure>
    <div class="aspect-[4/5] overflow-hidden sm:aspect-[16/9]">
      {%- render 'media',
        image: section.settings.image,
        placeholder: 'lifestyle-2',
        class: 'h-full w-full object-cover',
        sizes: '(min-width: 1600px) 1500px, 100vw'
      -%}
    </div>
    {%- if section.settings.caption != blank -%}
      <figcaption class="eyebrow mt-4 text-stone">{{ section.settings.caption }}</figcaption>
    {%- endif -%}
  </figure>
</section>

{% schema %}
{
  "name": "L’Atelier",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "atelier"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "04"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "L’ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "The Atelier"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Didascalia",
      "default": "Immagine"
    }
  ],
  "presets": [
    {
      "name": "L’Atelier"
    }
  ]
}
{% endschema %}
