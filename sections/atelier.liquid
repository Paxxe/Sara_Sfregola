<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="grid grid-cols-1 items-center gap-[15px] px-[8%] py-[85px] md:grid-cols-2 md:gap-[15%] md:px-[9%] md:py-[155px]"
>
  <div>
    <p class="eyebrow mb-[27px]">
      {%- if section.settings.number != blank -%}
        {{ section.settings.number }} /
      {% endif -%}
      {{ section.settings.eyebrow }}
    </p>
    <h2 class="mb-[30px] text-[34px] md:text-[42px]">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte max-w-[420px] leading-[1.9] text-[#6d695f]">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <figure class="m-0 pt-[25px] md:pt-[75px]">
    <div class="h-[400px] overflow-hidden md:h-[540px]">
      {%- render 'media',
        image: section.settings.image,
        placeholder: 'lifestyle-2',
        class: 'h-full w-full object-cover',
        sizes: '(min-width: 721px) 40vw, 100vw'
      -%}
    </div>
    {%- if section.settings.caption != blank -%}
      <figcaption class="mt-4 text-[8px] uppercase tracking-[2px]">{{ section.settings.caption }}</figcaption>
    {%- endif -%}
  </figure>
</section>

{% schema %}
{
  "name": "L’Atelier",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "atelier"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "04"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "L’ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "The Atelier"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Didascalia",
      "default": "IMMAGINE"
    }
  ],
  "presets": [{ "name": "L’Atelier" }]
}
{% endschema %}
