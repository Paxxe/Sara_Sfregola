<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="bespoke{% if section.settings.background == 'paper' %} bespoke--paper{% endif %}"
  aria-labelledby="Heading-{{ section.id }}"
>
  <figure class="bespoke__photo">
    {%- render 'media',
      image: section.settings.image,
      placeholder: 'lifestyle-1',
      class: 'h-full w-full object-cover object-[50%_42%]',
      sizes: '(min-width: 721px) 52vw, 100vw'
    -%}
  </figure>

  <div class="bespoke__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow mb-[27px]">
        {%- if section.settings.number != blank -%}
          {{ section.settings.number }} /
        {% endif -%}
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}
    {%- assign heading_tag = 'h2' -%}
    {%- if section.settings.page_heading -%}{%- assign heading_tag = 'h1' -%}{%- endif -%}
    <{{ heading_tag }} id="Heading-{{ section.id }}" class="editorial-title{% if section.settings.page_heading %} editorial-title--xl{% endif %}">
      {{- section.settings.heading -}}
      {%- if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{%- endif -%}
    </{{ heading_tag }}>
    {%- if section.settings.subheading != blank -%}
      <p class="bespoke__subheading">{{ section.settings.subheading | replace: '||', '<br>' }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte editorial-text my-[30px]">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="{% if section.settings.button_style == 'outline' %}line-link{% else %}btn-solid{% endif %} mt-[20px]" href="{{ section.settings.link_url | default: routes.root_url }}">
        {{- section.settings.link_label }} ↗
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Su misura",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "su-misura"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "SU MISURA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Un abito che"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Titolo (parte in corsivo)",
      "default": "ti somiglia"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sottotitolo",
      "info": "Usa il corsivo per le parole in serif. Scrivi || per andare a capo."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo pulsante",
      "default": "Richiedi una consulenza"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Stile pulsante",
      "options": [
        { "value": "solid", "label": "Pieno" },
        { "value": "outline", "label": "Contorno" }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Sfondo testo",
      "options": [
        { "value": "sand", "label": "Sabbia" },
        { "value": "paper", "label": "Carta" }
      ],
      "default": "sand"
    },
    {
      "type": "checkbox",
      "id": "page_heading",
      "label": "Titolo principale della pagina (H1, più grande)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Su misura",
      "category": "Editoriale"
    }
  ]
}
{% endschema %}
