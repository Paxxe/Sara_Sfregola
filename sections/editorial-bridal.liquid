<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="grid grid-cols-1 bg-linen md:min-h-[660px] md:grid-cols-2"
>
  <div class="h-[490px] overflow-hidden md:h-[660px]">
    {%- render 'media',
      image: section.settings.image,
      placeholder: 'lifestyle-1',
      class: 'h-full w-full object-cover object-[center_25%]',
      sizes: '(min-width: 721px) 50vw, 100vw'
    -%}
  </div>

  <div class="self-center px-[8%] py-[60px] md:px-[10%] lg:px-[14%] lg:py-[90px]">
    <p class="eyebrow mb-[27px]">
      {%- if section.settings.number != blank -%}
        {{ section.settings.number }} /
      {% endif -%}
      {{ section.settings.eyebrow }}
    </p>
    <h2 class="text-[34px] md:text-[43px]">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte my-[30px] leading-[1.9]">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="line-link mt-[30px]" href="{{ section.settings.link_url | default: routes.root_url }}">
        {{- section.settings.link_label }} ↗
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editoriale · Sposa e Cerimonia",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "sposa"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "03"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "BRIDAL & CEREMONY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Sposa e Cerimonia"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo pulsante",
      "default": "Scopri la consulenza privata"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Sposa e Cerimonia",
      "category": "Editoriale"
    }
  ]
}
{% endschema %}
