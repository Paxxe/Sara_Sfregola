<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="bespoke"
  aria-labelledby="Heading-{{ section.id }}"
>
  <figure class="bespoke__photo">
    {%- render 'media',
      image: section.settings.image,
      placeholder: 'lifestyle-1',
      class: 'h-full w-full object-cover object-[50%_42%]',
      sizes: '(min-width: 721px) 52vw, 100vw'
    -%}
  </figure>

  <div class="bespoke__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow mb-[27px]">
        {%- if section.settings.number != blank -%}
          {{ section.settings.number }} /
        {% endif -%}
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}
    <h2 id="Heading-{{ section.id }}" class="editorial-title">
      {{- section.settings.heading -}}
      {%- if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{%- endif -%}
    </h2>
    {%- if section.settings.text != blank -%}
      <div class="rte editorial-text my-[30px]">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="btn-solid" href="{{ section.settings.link_url | default: routes.root_url }}">
        {{- section.settings.link_label }} ↗
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Su misura",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "su-misura"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "SU MISURA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Un abito che"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Titolo (parte in corsivo)",
      "default": "ti somiglia"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo pulsante",
      "default": "Richiedi una consulenza"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Su misura",
      "category": "Editoriale"
    }
  ]
}
{% endschema %}
