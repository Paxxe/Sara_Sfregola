{%- liquid
  assign heading_text = section.settings.heading
  if search.performed
    assign heading_text = 'search.results_for' | t: terms: search.terms
  endif
-%}

<header class="px-[7%] pb-[40px] pt-[60px] text-center md:px-[4%] md:pb-[60px] md:pt-[90px]">
  <p class="eyebrow mb-7 md:mb-[38px]">{{ section.settings.eyebrow }}</p>
  <h1 class="text-[34px] leading-[1.22] md:text-[42px] md:leading-[1.17]">{{ heading_text }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="mx-auto mt-[35px] flex max-w-[560px] items-center border-b border-ink">
    <label for="SearchInput-{{ section.id }}" class="sr-only">{{ 'search.label' | t }}</label>
    <input
      id="SearchInput-{{ section.id }}"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      class="w-full border-0 bg-transparent px-0 py-3 text-[15px] placeholder:text-muted focus:outline-none"
    >
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="py-3 pl-4 text-[11px]">{{ 'search.submit' | t }} ↗</button>
  </form>

  {%- if search.performed -%}
    <p class="mt-[18px] text-[9px] uppercase tracking-[1px]" role="status">
      {{ 'search.count' | t: count: search.results_count }}
    </p>
  {%- endif -%}
</header>

<div class="px-[6%] pb-20 md:pb-[130px]">
  {%- if search.performed -%}
    {%- paginate search.results by section.settings.per_page -%}
      {%- if search.results_count > 0 -%}
        {%- comment -%} Prodotti {%- endcomment -%}
        <div class="plp-grid plp-grid--3 plp-grid--staggered">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card',
                product: item,
                image_class: 'aspect-[3/4]',
                sizes: '(min-width: 721px) 33vw, 50vw',
                show_secondary: true,
                show_badges: true
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Pagine e articoli {%- endcomment -%}
        {%- capture other_results -%}
          {%- for item in search.results -%}
            {%- unless item.object_type == 'product' -%}
              <li>
                <a href="{{ item.url }}" class="flex items-baseline justify-between gap-6 border-t border-line py-5">
                  <span>
                    <span class="eyebrow block text-muted">
                      {%- if item.object_type == 'article' -%}{{ 'search.article' | t }}{%- else -%}{{ 'search.page' | t }}{%- endif -%}
                    </span>
                    <span class="mt-1 block text-[18px] tracking-[-0.3px]">{{ item.title }}</span>
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if other_results != blank -%}
          <div class="mx-auto mt-[90px] max-w-[820px]">
            <p class="eyebrow mb-[22px]">{{ 'search.other_results' | t }}</p>
            <ul class="border-b border-line">{{ other_results }}</ul>
          </div>
        {%- endif -%}

        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <div class="text-center">
          <p class="mx-auto max-w-[430px] leading-[1.9] text-ink-soft">{{ 'search.no_results' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="line-link mt-[35px]">{{ 'cart.explore' | t }} ↗</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Risultati ricerca",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "RICERCA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo (prima della ricerca)",
      "default": "Cerca nell’atelier"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Risultati per pagina",
      "min": 6,
      "max": 36,
      "step": 6,
      "default": 18
    }
  ]
}
{% endschema %}
