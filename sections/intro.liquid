<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="page-width section-y text-center"
>
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow mb-8 text-stone">{{ section.settings.eyebrow }}</p>
  {%- endif -%}

  <h2 class="display-xl mx-auto max-w-5xl">
    {{- section.settings.heading -}}
    {%- if section.settings.heading_italic != blank -%}
      <br><em class="font-light italic">{{ section.settings.heading_italic }}</em>
    {%- endif -%}
  </h2>

  {%- if section.settings.text != blank -%}
    <div class="rte mx-auto mt-10 max-w-xl text-base leading-relaxed text-ink/75">
      {{ section.settings.text }}
    </div>
  {%- endif -%}

  {%- if section.settings.link_label != blank -%}
    <a class="line-link mt-12" href="{{ section.settings.link_url | default: routes.root_url }}">
      {{- section.settings.link_label }} <span aria-hidden="true">↗</span>
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Introduzione",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "intro",
      "info": "Usabile nei link come #intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "THE ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Creazioni"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Titolo (seconda riga, corsivo)",
      "default": "fatte a mano."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo link",
      "default": "Entra nell’atelier"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Introduzione"
    }
  ]
}
{% endschema %}
