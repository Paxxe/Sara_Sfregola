<div class="care">
  <section class="care__heading">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow mb-[27px]">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="care__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="rte editorial-text mt-6 max-w-[60ch] text-ink-soft">{{ section.settings.text }}</div>
    {%- endif -%}
  </section>

  {%- if section.blocks.size > 0 -%}
    <section class="care__options">
      {%- for block in section.blocks -%}
        <article class="care__option" {{ block.shopify_attributes }}>
          {%- if block.settings.eyebrow != blank -%}
            <p class="eyebrow mb-[20px]">{{ forloop.index | prepend: '0' | slice: -2, 2 }} / {{ block.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="care__option-title">{{ block.settings.title }}</h2>
          {%- if block.settings.text != blank -%}
            <div class="rte mt-3 text-[13px] leading-[1.7] text-muted">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a class="line-link mt-[18px]" href="{{ block.settings.link_url | default: '#messaggio' }}">
              {{- block.settings.link_label }} ↗
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Contatti e opzioni",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "CONTATTI / CUSTOMER CARE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Contatti & Customer Care",
      "info": "Se vuoto usa il titolo della pagina."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Opzione",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Sopratitolo",
          "default": "L’ATELIER"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titolo",
          "default": "L’Atelier"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Testo pulsante",
          "default": "Prepara un messaggio"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link",
          "info": "Se vuoto porta al modulo della pagina (#messaggio)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contatti e opzioni",
      "category": "Contatti e assistenza",
      "blocks": [
        { "type": "option", "settings": { "eyebrow": "L’ATELIER", "title": "L’Atelier", "link_label": "Prepara un appuntamento" } },
        { "type": "option", "settings": { "eyebrow": "ASSISTENZA PERSONALE", "title": "Assistenza clienti" } },
        { "type": "option", "settings": { "eyebrow": "PRESS & COLLABORATIONS", "title": "Press e collaborazioni", "link_label": "Raccontaci il progetto" } }
      ]
    }
  ]
}
{% endschema %}
