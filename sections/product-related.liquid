{%- comment -%}
  "Completa il look" — abbinamenti (related-looks).
  Fonte: metafield prodotto (lista di prodotti, es. custom.abbinamenti)
  oppure raccomandazioni Shopify (complementari / correlate) caricate via JS.
  Composizione asimmetrica come la griglia "Creazioni" dell'homepage.
{%- endcomment -%}
{%- liquid
  assign related_products = nil
  if section.settings.source == 'metafield' and section.settings.metafield != blank and product
    assign key_parts = section.settings.metafield | strip | split: '.'
    if key_parts.size == 2
      assign related_products = product.metafields[key_parts[0]][key_parts[1]].value
    endif
  endif

  assign is_recommendations = false
  if section.settings.source != 'metafield' or related_products == blank
    assign is_recommendations = true
  endif
  assign intent = 'related'
  if section.settings.source == 'complementary'
    assign intent = 'complementary'
  endif
-%}

<section aria-labelledby="RelatedTitle-{{ section.id }}" class="px-[6%] pb-20 pt-[70px] md:pb-[130px] md:pt-[110px]">
  <div class="mb-[35px] md:mb-[55px]">
    <p class="eyebrow mb-[22px]">{{ section.settings.eyebrow }}</p>
    <h2 id="RelatedTitle-{{ section.id }}" class="text-[29px] md:text-[35px]">{{ section.settings.heading }}</h2>
  </div>

  {%- if is_recommendations -%}
    <product-recommendations
      class="block"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ intent }}"
    >
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        <div class="creations-grid">
          {%- for rec in recommendations.products -%}
            {%- render 'product-card', product: rec, show_badges: true -%}
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode or product == blank -%}
        {%- comment -%} Anteprima nell'editor: segnaposto come nella bozza {%- endcomment -%}
        <div class="creations-grid">
          {%- assign placeholder_titles = 'Stola,Corsetto,Accessorio' | split: ',' -%}
          {%- for title in placeholder_titles -%}
            {%- render 'product-card', title: title -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-recommendations>
  {%- else -%}
    <div class="creations-grid">
      {%- for rel in related_products limit: section.settings.limit -%}
        {%- render 'product-card', product: rel, show_badges: true -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Completa il look",
  "tag": "div",
  "class": "section-product-related",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "ABBINAMENTI"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Completa il look"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Prodotti",
      "options": [
        { "value": "metafield", "label": "Scelti a mano (metafield)" },
        { "value": "complementary", "label": "Complementari (Search & Discovery)" },
        { "value": "related", "label": "Correlati automatici" }
      ],
      "default": "metafield",
      "info": "Se il metafield è vuoto vengono usati i prodotti correlati automatici."
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "Metafield abbinamenti",
      "default": "custom.abbinamenti",
      "info": "Metafield di tipo \"Lista di prodotti\"."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Numero di prodotti",
      "min": 3,
      "max": 6,
      "step": 3,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Completa il look",
      "category": "Prodotto"
    }
  ]
}
{% endschema %}
