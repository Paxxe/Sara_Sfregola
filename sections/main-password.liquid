<section class="grid min-h-[100svh] grid-cols-1 md:grid-cols-2">
  <div class="h-[45svh] overflow-hidden bg-oat md:h-auto">
    {%- render 'media',
      image: section.settings.image,
      placeholder: 'lifestyle-1',
      class: 'h-full w-full object-cover',
      sizes: '(min-width: 721px) 50vw, 100vw',
      priority: true
    -%}
  </div>

  <div class="flex flex-col justify-between px-[8%] py-[45px] md:px-[12%] md:py-[60px]">
    <div class="w-[120px]">
      {%- render 'logo', class: 'block w-full brightness-0', text_class: 'items-start text-left text-[22px]', sizes: '120px' -%}
    </div>

    <div class="py-[60px]">
      <p class="eyebrow mb-[27px]">{{ section.settings.eyebrow }}</p>
      <h1 class="text-[34px] leading-[1.22] md:text-[42px] md:leading-[1.17]">
        {{- section.settings.heading -}}
        {%- if section.settings.italic != blank -%}<br><em>{{ section.settings.italic }}</em>{%- endif -%}
      </h1>
      {%- if shop.password_message != blank -%}
        <p class="mt-[27px] max-w-[430px] leading-[1.9] text-ink-soft">{{ shop.password_message }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'mt-[35px] max-w-[430px]' -%}
        <input type="hidden" name="contact[tags]" value="password page, newsletter">
        {%- render 'form-messages', form: form, success: section.settings.success_message -%}
        <label for="PasswordNewsletter" class="field-label">{{ 'contact.email' | t }}</label>
        <div class="flex items-center border-b border-ink">
          <input
            id="PasswordNewsletter"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            class="w-full border-0 bg-transparent px-0 py-3 text-[13px] focus:outline-none"
          >
          <button type="submit" class="py-3 pl-4 text-[11px]">{{ section.settings.button_label }} ↗</button>
        </div>
      {%- endform -%}
    </div>

    <details class="text-[11px]">
      <summary class="text-muted">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'mt-4 max-w-[430px]' -%}
        {%- render 'form-messages', form: form -%}
        <label for="StorePassword" class="field-label">{{ 'password.label' | t }}</label>
        <div class="flex items-center border-b border-ink">
          <input
            id="StorePassword"
            type="password"
            name="password"
            autocomplete="current-password"
            class="w-full border-0 bg-transparent px-0 py-3 text-[13px] focus:outline-none"
          >
          <button type="submit" class="py-3 pl-4 text-[11px]">{{ 'password.enter' | t }} ↗</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Pagina password",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "PROSSIMAMENTE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "L’atelier"
    },
    {
      "type": "text",
      "id": "italic",
      "label": "Seconda riga (corsivo)",
      "default": "apre presto."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante iscrizione",
      "default": "Avvisami"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Messaggio di conferma",
      "default": "Grazie, ti scriveremo all’apertura."
    }
  ]
}
{% endschema %}
