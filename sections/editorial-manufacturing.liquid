<section class="px-[8%] pb-20 pt-[55px] md:px-[12%] md:pb-[145px] md:pt-[95px]">
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow mb-[27px]">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 class="max-w-[900px] text-[31px] leading-[1.3] md:text-[42px] md:leading-[1.17]">{{ section.settings.heading }}</h2>

  <div class="mt-[45px] grid grid-cols-1 gap-[25px] md:mt-[85px] md:grid-cols-3 md:gap-20">
    {%- for block in section.blocks -%}
      <article class="border-t border-line pt-5" {{ block.shopify_attributes }}>
        <span class="text-[9px] text-[#8b8578]">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <h3 class="mb-3 mt-[15px] text-[15px] font-normal md:mt-[25px]">{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}
          <div class="rte text-[12px] leading-[1.9] text-[#777267]">{{ block.settings.text }}</div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Tempo di lavorazione",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "MANIFATTURA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Il tempo di lavorazione"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Voce",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titolo",
          "default": "Ore di manifattura"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tempo di lavorazione",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Ore di manifattura"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Tempi di realizzazione"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Cura del capo"
          }
        }
      ],
      "category": "Editoriale"
    }
  ]
}
{% endschema %}
