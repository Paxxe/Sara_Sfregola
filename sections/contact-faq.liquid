<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="px-[8%] py-[65px] md:px-[15%] md:py-[95px]"
>
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow mb-[27px]">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 class="mb-[35px] text-[28px] leading-[1.3] md:text-[33px] md:leading-[1.17]">{{ section.settings.heading }}</h2>

  <div>
    {%- for block in section.blocks -%}
      <details class="accordion" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="accordion-body">
          {%- if block.settings.answer != blank -%}
            <div class="rte">{{ block.settings.answer }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a class="line-link mt-4 text-ink" href="{{ block.settings.link_url | default: routes.root_url }}">
              {{- block.settings.link_label }} ↗
            </a>
          {%- endif -%}
        </div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "faq"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "CUSTOMER CARE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "FAQ"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Domanda",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Domanda",
          "default": "Ordini e creazioni"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Risposta"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Testo pulsante",
          "default": "Customer care"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Ordini e creazioni"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Taglie e vestibilità"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Tempi di realizzazione"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Spedizioni e resi"
          }
        }
      ],
      "category": "Contatti e assistenza"
    }
  ]
}
{% endschema %}
