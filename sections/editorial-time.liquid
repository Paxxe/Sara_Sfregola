<section class="work-hours{% if section.settings.spacious %} work-hours--spacious{% endif %}" aria-labelledby="Heading-{{ section.id }}">
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow mb-[27px]">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 id="Heading-{{ section.id }}" class="editorial-title">
    {{- section.settings.heading | replace: '||', '<br>' -}}
    {%- if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{%- endif -%}
  </h2>

  {%- if section.settings.text != blank -%}
    <div class="rte editorial-text mx-auto mt-6 max-w-[66ch]">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- if section.settings.link_label != blank or section.settings.button_label != blank -%}
    <div class="work-hours__actions">
      {%- if section.settings.link_label != blank -%}
        <a class="line-link" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">
          {{- section.settings.link_label -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn-solid" href="{{ section.settings.button_url | default: routes.root_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Il valore del tempo",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titolo",
      "default": "Il valore",
      "info": "Usa il corsivo per le parole in serif. Scrivi || per andare a capo."
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Titolo (parte in corsivo)",
      "default": "del tempo"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo",
      "default": "<p>Ci sono ore che restano tra i fili. Nei nodi di un merletto, in un ricamo, nelle prove che danno all’abito la sua forma. Ore di mani, di attenzione, di scelte. È questo tempo a rendere ogni creazione irripetibile.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Pulsante secondario",
      "default": "Esplora le creazioni"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link pulsante secondario"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Pulsante principale",
      "default": "Richiedi una consulenza privata"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link pulsante principale"
    },
    {
      "type": "checkbox",
      "id": "spacious",
      "label": "Spaziatura ampia sopra",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Il valore del tempo",
      "category": "Editoriale"
    }
  ]
}
{% endschema %}
