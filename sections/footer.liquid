<footer class="bg-forest px-[5%] pb-6 pt-[75px] text-cloud">
  <div>
    <div class="w-[135px] md:w-[165px]">
      {%- render 'logo',
        image: settings.logo_footer,
        class: 'block w-full',
        text_class: 'items-start text-left text-[27px] tracking-[3px]',
        sizes: '165px'
      -%}
    </div>
    {%- if section.settings.tagline != blank -%}
      <span class="mt-[35px] block text-[7px] uppercase leading-[1.8] tracking-[2.5px] md:text-[8px]">
        {{- section.settings.tagline -}}
      </span>
    {%- endif -%}
  </div>

  {%- if section.settings.menu.links.size > 0 -%}
    <nav aria-label="{{ section.settings.menu.title | escape }}" class="flex flex-wrap gap-[25px] py-[45px] text-[10px] md:gap-[35px]">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <div class="flex flex-wrap justify-between gap-5 border-t border-white/20 pt-5 text-[8px] uppercase leading-[1.8] tracking-[1px]">
    <span>© {{ shop.name }}</span>
    {%- if section.settings.note != blank -%}
      <span class="max-w-[160px] md:max-w-none">{{ section.settings.note }}</span>
    {%- endif -%}
    {%- for link in section.settings.secondary_menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
    <a href="#MainContent" aria-label="{{ 'general.back_to_top' | t }}">↑</a>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Claim",
      "default": "ARTI TESSILI · ALTA SARTORIALITÀ · BARLETTA"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "secondary_menu",
      "label": "Menu barra inferiore",
      "info": "Es. Press, Customer Care"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota",
      "default": "BOZZA GRAFICA · CONTENUTI DA DEFINIRE"
    }
  ]
}
{% endschema %}
