<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="px-[7%] py-[85px] text-center md:px-[25px] md:py-[100px]"
>
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow mb-7 md:mb-[38px]">{{ section.settings.eyebrow }}</p>
  {%- endif -%}

  <h2 class="text-[34px] leading-[1.22] md:text-[35px] md:leading-[1.17]">
    {{- section.settings.heading -}}
    {%- if section.settings.heading_italic != blank -%}
      <br><em>{{ section.settings.heading_italic }}</em>
    {%- endif -%}
  </h2>

  {%- if section.settings.text != blank -%}
    <div class="rte mx-auto my-[27px] max-w-[430px] text-[12px] leading-[1.95] text-ink-soft md:my-[35px] md:text-[13px]">
      {{ section.settings.text }}
    </div>
  {%- endif -%}

  {%- if section.settings.link_label != blank -%}
    <a class="line-link mt-[30px]" href="{{ section.settings.link_url | default: routes.root_url }}">
      {{- section.settings.link_label }} ↗
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Editoriale · Introduzione",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "THE ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Creazioni"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Seconda riga (corsivo serif)",
      "default": "fatte a mano."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo pulsante",
      "default": "Entra nell’atelier"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Introduzione",
      "category": "Editoriale"
    }
  ]
}
{% endschema %}
