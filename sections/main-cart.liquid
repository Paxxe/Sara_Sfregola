{%- render 'page-heading',
  eyebrow: section.settings.eyebrow,
  title: section.settings.heading,
  italic: section.settings.italic
-%}

<div class="px-[6%] pb-20 md:px-[4%] md:pb-[130px]">
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="grid grid-cols-1 gap-[45px] md:grid-cols-[1.6fr_1fr] md:gap-[6%]" data-cart-form>
      {%- comment -%} ===================== Articoli ===================== {%- endcomment -%}
      <div>
        <div class="hidden grid-cols-[1fr_120px_110px] gap-6 border-b border-line pb-3 text-[9px] uppercase tracking-[1.35px] text-muted md:grid">
          <span>{{ 'cart.product' | t }}</span>
          <span>{{ 'cart.quantity' | t }}</span>
          <span class="text-right">{{ 'cart.total' | t }}</span>
        </div>

        <ul>
          {%- for item in cart.items -%}
            <li class="grid grid-cols-[90px_1fr] gap-x-5 gap-y-4 border-b border-line py-6 md:grid-cols-[110px_1fr_120px_110px] md:items-start md:gap-6">
              <a href="{{ item.url }}" class="block aspect-[3/4] overflow-hidden bg-mist md:row-span-1">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 400 | image_tag: class: 'h-full w-full object-cover', widths: '200,300,400', sizes: '110px', loading: 'lazy' }}
                {%- else -%}
                  {{- 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' -}}
                {%- endif -%}
              </a>

              <div class="min-w-0">
                <a href="{{ item.url }}" class="text-[13px]">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="mt-2 text-[11px] text-muted">
                    {%- for option in item.options_with_values -%}
                      {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
                    {%- endfor -%}
                  </p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- assign first_char = property.first | slice: 0 -%}
                  {%- if property.last != blank and first_char != '_' -%}
                    <p class="mt-1 text-[11px] text-muted">{{ property.first }}: {{ property.last }}</p>
                  {%- endif -%}
                {%- endfor -%}
                <p class="mt-2 text-[11px]">
                  {{ item.final_price | money }}
                  {%- if item.original_price > item.final_price %}
                    <s class="ml-1 text-muted">{{ item.original_price | money }}</s>
                  {%- endif -%}
                </p>
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="mt-1 text-[10px] text-muted">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
                {%- endfor -%}
                <a href="{{ item.url_to_remove }}" class="mt-4 inline-block border-b border-ink pb-px text-[10px]">
                  {{- 'cart.remove' | t -}}
                </a>
              </div>

              <div class="col-start-2 flex w-[120px] items-center justify-between rounded-full border border-pill px-2 md:col-start-auto" data-quantity>
                <button type="button" class="px-2 py-2 text-[15px]" aria-label="{{ 'cart.decrease' | t }}" data-step="-1">−</button>
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  class="w-8 border-0 bg-transparent p-0 text-center text-[12px] [appearance:textfield] focus:outline-none [&::-webkit-inner-spin-button]:appearance-none"
                  aria-label="{{ 'cart.quantity' | t }} — {{ item.product.title | escape }}"
                  data-autosubmit
                >
                <button type="button" class="px-2 py-2 text-[15px]" aria-label="{{ 'cart.increase' | t }}" data-step="1">+</button>
              </div>

              <p class="col-start-2 text-[13px] md:col-start-auto md:text-right">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>

        <a href="{{ routes.all_products_collection_url }}" class="line-link mt-[35px]">← {{ 'cart.continue' | t }}</a>
      </div>

      {%- comment -%} ===================== Riepilogo ===================== {%- endcomment -%}
      <aside class="md:sticky md:top-[30px] md:self-start">
        <div class="bg-oat p-[30px] md:p-[40px]">
          <p class="eyebrow mb-[22px]">{{ 'cart.summary' | t }}</p>

          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="flex justify-between border-t border-line py-3 text-[11px]">
              <span class="text-muted">{{ discount.title }}</span>
              <span>−{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}

          <div class="flex justify-between border-y border-line py-4 text-[13px]">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>

          <p class="mt-3 text-[10px] leading-[1.8] text-muted">{{ 'cart.taxes_note' | t }}</p>

          {%- if section.settings.show_note -%}
            <label class="block">
              <span class="field-label">{{ section.settings.note_label }}</span>
              <textarea class="field min-h-[90px]" name="note" form="CartForm">{{ cart.note }}</textarea>
            </label>
          {%- endif -%}

          <button type="submit" name="checkout" class="btn-solid mt-6 w-full">{{ 'cart.checkout' | t }} ↗</button>
          <noscript>
            <button type="submit" name="update" class="line-link mt-3 w-full">{{ 'cart.update' | t }}</button>
          </noscript>

          {%- if additional_checkout_buttons and section.settings.show_dynamic_checkout -%}
            <div class="mt-3">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.consult_text != blank -%}
          <a href="{{ section.settings.consult_url | default: routes.root_url }}" class="mt-[18px] block text-center text-[11px] underline underline-offset-4">
            {{- section.settings.consult_text }} ↗
          </a>
        {%- endif -%}
      </aside>
    </form>
  {%- else -%}
    <div class="pb-[40px] text-center">
      <p class="mx-auto max-w-[430px] leading-[1.9] text-ink-soft">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="line-link mt-[35px]">{{ 'cart.explore' | t }} ↗</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Carrello",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "CARRELLO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Le tue"
    },
    {
      "type": "text",
      "id": "italic",
      "label": "Seconda riga (corsivo)",
      "default": "creazioni."
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Note per l'atelier",
      "default": true
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Etichetta note",
      "default": "Note per l'atelier (misure, ricorrenze, richieste)"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Pagamenti rapidi (Shop Pay, Apple Pay…)",
      "default": false
    },
    {
      "type": "text",
      "id": "consult_text",
      "label": "Link consulenza",
      "default": "Hai bisogno di un consiglio? Parliamone"
    },
    {
      "type": "url",
      "id": "consult_url",
      "label": "Link consulenza — destinazione"
    }
  ]
}
{% endschema %}
