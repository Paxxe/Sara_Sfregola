<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="grid grid-cols-1 bg-paper px-[6%] pb-[65px] pt-[15px] md:grid-cols-[1.05fr_1fr] md:gap-[6%] md:px-[4%] md:pb-[110px] md:pt-[30px]"
>
  <div class="relative min-h-[460px] md:min-h-[650px] lg:min-h-[760px]">
    {%- render 'media',
      image: section.settings.image,
      placeholder: 'detailed-apparel-1',
      class: 'absolute inset-0 h-full w-full object-cover',
      sizes: '(min-width: 721px) 52vw, 100vw'
    -%}
  </div>

  <div class="pt-[55px] md:self-center md:pb-[30px] md:pr-[5%] md:pt-[90px] lg:pr-[14%]">
    <p class="eyebrow mb-[27px]">
      {%- if section.settings.number != blank -%}
        {{ section.settings.number }} /
      {% endif -%}
      {{ section.settings.eyebrow }}
    </p>
    <h2 class="text-[37px] leading-[1.2] md:text-[45px]">{{ section.settings.heading }}</h2>

    {%- if section.settings.text != blank -%}
      <div class="rte my-[30px] leading-[1.9] text-ink-soft">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="mt-[30px]">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.title }}</summary>
          <div class="accordion-body">
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="line-link mt-4 text-ink" href="{{ block.settings.link_url | default: routes.root_url }}">
                {{- block.settings.link_label }} ↗
              </a>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Savoir-faire",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "savoir-faire"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "02"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "SAVOIR-FAIRE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Le tecniche artigianali"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    }
  ],
  "blocks": [
    {
      "type": "technique",
      "name": "Tecnica",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nome tecnica",
          "default": "Tombolo"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Descrizione"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Testo pulsante",
          "default": "Scopri la tecnica"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Savoir-faire",
      "blocks": [
        { "type": "technique", "settings": { "title": "Tombolo" } },
        { "type": "technique", "settings": { "title": "Chiacchierino" } },
        { "type": "technique", "settings": { "title": "Macramè" } },
        { "type": "technique", "settings": { "title": "Corsetteria e drappeggio" } }
      ]
    }
  ]
}
{% endschema %}
