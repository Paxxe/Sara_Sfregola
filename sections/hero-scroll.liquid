{%- comment -%}
  Hero "racconto visivo" — come home-presentation.js:
  la sezione è alta (100svh + 70svh per ogni slide in più), lo stage è sticky e,
  scorrendo la pagina, il binario sinistro scorre verso sinistra mentre quello destro
  scorre in senso opposto. Pulsanti ← → portano alla slide precedente / successiva,
  il pulsante Ⅱ disattiva il movimento continuo (scatto a slide intere).
  Ogni blocco "Slide" fornisce l'immagine del pannello sinistro e di quello destro.
{%- endcomment -%}
{%- liquid
  assign slide_count = section.blocks.size
  assign steps = slide_count | minus: 1
  if steps < 0
    assign steps = 0
  endif
-%}

<hero-scroll class="hero-scroll relative block" style="--hero-steps: {{ steps }};">
  <section
    aria-label="{{ section.settings.aria_label | escape }}"
    class="sticky top-0 grid h-[100svh] grid-cols-1 grid-rows-2 overflow-hidden bg-oat md:grid-cols-2 md:grid-rows-1"
    data-stage
  >
    {%- comment -%} Pannello sinistro {%- endcomment -%}
    <div class="h-full min-h-0 min-w-0 overflow-hidden">
      <div class="hero-rail flex h-full w-full" data-rail="left">
        {%- for block in section.blocks -%}
          <figure class="m-0 h-full w-full flex-[0_0_100%] overflow-hidden" {{ block.shopify_attributes }}>
            {%- render 'media',
              image: block.settings.image_left,
              placeholder: 'lifestyle-1',
              class: 'h-full w-full object-cover',
              sizes: '(min-width: 721px) 50vw, 100vw',
              priority: forloop.first
            -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%}
      Pannello destro: ordine invertito, parte dall'ultima figura e scorre in senso opposto
    {%- endcomment -%}
    <div class="h-full min-h-0 min-w-0 overflow-hidden">
      <div class="hero-rail flex h-full w-full" data-rail="right">
        {%- for block in section.blocks reversed -%}
          <figure class="m-0 h-full w-full flex-[0_0_100%] overflow-hidden">
            {%- render 'media',
              image: block.settings.image_right,
              placeholder: 'lifestyle-2',
              class: 'h-full w-full object-cover',
              sizes: '(min-width: 721px) 50vw, 100vw',
              priority: forloop.last
            -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Logo centrale {%- endcomment -%}
    <a
      href="#"
      class="absolute left-1/2 top-[46%] z-[2] w-[150px] -translate-x-1/2 -translate-y-1/2 text-ink md:top-[42%] md:w-[185px]"
      aria-label="{{ section.settings.logo_label | escape }}"
      data-scroll-next
    >
      {%- render 'logo',
        image: section.settings.logo,
        class: 'block w-full brightness-0',
        text_class: 'items-center text-center text-[22px] md:text-[28px]',
        sizes: '185px'
      -%}
    </a>

    {%- comment -%} Testo editoriale {%- endcomment -%}
    <div class="absolute bottom-[90px] left-[6%] z-[2] text-ink md:bottom-[104px] md:left-[4%]">
      {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
        <p class="eyebrow mb-[14px] max-w-[240px] text-[7px] md:mb-4 md:max-w-none md:text-[8px]">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="mb-[15px] text-[25px] leading-[1.2] tracking-[-0.5px] md:mb-[23px] md:text-[29px]">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a
          class="inline-block rounded-full bg-paper px-8 py-[17px] text-center text-[10px] leading-[1.4] tracking-[0.4px]"
          href="{{ section.settings.link_url | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.link_label }} ↗
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Barra inferiore {%- endcomment -%}
    <div class="absolute bottom-5 left-[6%] right-[6%] z-[2] flex items-center justify-between gap-3 text-[7px] tracking-[1.2px] text-cue md:bottom-[29px] md:left-[4%] md:right-[4%] md:text-[8px]">
      <a href="#" class="rounded-full" data-scroll-next>{{ section.settings.scroll_label }} ↓</a>

      {%- if slide_count > 1 -%}
        <div class="flex items-center gap-[14px] md:gap-5">
          <button
            type="button"
            class="rounded-full px-2 py-1 text-[19px] text-ink"
            aria-label="{{ 'sections.hero.previous' | t }}"
            data-prev
          >
            ←
          </button>
          <span data-counter>01 / {{ slide_count | prepend: '0' | slice: -2, 2 }}</span>
          <button
            type="button"
            class="rounded-full px-2 py-1 text-[19px] text-ink"
            aria-label="{{ 'sections.hero.next' | t }}"
            data-next
          >
            →
          </button>
          <button
            type="button"
            class="rounded-full px-2 py-1 text-[12px] text-ink"
            aria-pressed="false"
            aria-label="{{ 'sections.hero.pause' | t }}"
            data-label-pause="{{ 'sections.hero.pause' | t }}"
            data-label-play="{{ 'sections.hero.play' | t }}"
            data-motion-toggle
          >
            Ⅱ
          </button>
        </div>
      {%- endif -%}

      <span class="hidden max-w-[200px] text-right md:block">{{ section.settings.location }}</span>
    </div>

    {%- comment -%} Barra di avanzamento {%- endcomment -%}
    <div class="absolute inset-x-0 bottom-0 h-[2px] bg-line" aria-hidden="true">
      <span class="block h-full w-0 bg-taupe" data-progress></span>
    </div>
  </section>
</hero-scroll>

{% schema %}
{
  "name": "Hero racconto visivo",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Etichetta accessibilità",
      "default": "Racconto visivo dell’atelier"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo centrale",
      "info": "Se vuoto usa il logo delle impostazioni tema."
    },
    {
      "type": "text",
      "id": "logo_label",
      "label": "Etichetta link logo",
      "default": "Sara Sfregola, scopri il nostro mondo"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Mostra sopratitolo",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "SARA SFREGOLA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Creazioni"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo pulsante",
      "default": "Esplora le creazioni"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link pulsante"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Invito allo scroll",
      "default": "SCORRI PER ESPLORARE"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Località",
      "default": "BARLETTA, ITALIA"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_left",
          "label": "Immagine pannello sinistro"
        },
        {
          "type": "image_picker",
          "id": "image_right",
          "label": "Immagine pannello destro"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero racconto visivo",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
