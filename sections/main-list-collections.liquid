{%- render 'page-heading',
  eyebrow: section.settings.eyebrow,
  title: section.settings.heading,
  italic: section.settings.italic
-%}

<div class="px-[6%] pb-20 md:pb-[130px]">
  {%- paginate collections by 24 -%}
    <div class="plp-grid plp-grid--3 plp-grid--staggered">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a href="{{ collection.url }}" class="group block">
            <div class="aspect-[4/5] overflow-hidden bg-mist">
              {%- assign collection_image = collection.featured_image | default: collection.products.first.featured_media -%}
              {%- if collection_image -%}
                {{ collection_image | image_url: width: 1200 | image_tag: class: 'h-full w-full object-cover', widths: '400,600,800,1200', sizes: '(min-width: 721px) 33vw, 50vw', loading: 'lazy' }}
              {%- else -%}
                {{- 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' -}}
              {%- endif -%}
            </div>
            <div class="mt-3 flex items-center justify-between border-t border-line pt-[10px] md:mt-[17px] md:pt-3">
              <h2 class="text-[12px] tracking-normal md:text-[13px]">{{ collection.title }}</h2>
              <span aria-hidden="true">↗</span>
            </div>
            <p class="mt-[9px] text-[8px] uppercase tracking-[0.3px] text-muted md:text-[9px]">
              {{ 'collections.count' | t: count: collection.products_count }}
            </p>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Elenco collezioni",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "LE COLLEZIONI"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Creazioni"
    },
    {
      "type": "text",
      "id": "italic",
      "label": "Seconda riga (corsivo)",
      "default": "fatte a mano."
    }
  ]
}
{% endschema %}
