{%- comment -%}
  PLP — pagina collezione nello stile dell'homepage.
  Intestazione editoriale, tab categorie, drawer filtri/ordinamento (Search & Discovery),
  griglia sfalsata e blocchi editoriali inseriti tra i prodotti.
{%- endcomment -%}
{%- liquid
  assign drawer_id = 'FilterDrawer-' | append: section.id
  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  comment
    Tab: menu dedicato oppure i valori di un filtro (es. "Tipo di prodotto")
  endcomment
  assign tabs_filter = nil
  if section.settings.tabs_menu == blank and section.settings.tabs_filter_label != blank
    for filter in collection.filters
      if filter.label == section.settings.tabs_filter_label and filter.type == 'list'
        assign tabs_filter = filter
        break
      endif
    endfor
  endif

  assign subtitle = collection.metafields.custom.sottotitolo.value | default: section.settings.subtitle
-%}

{%- comment -%} ===================== Intestazione ===================== {%- endcomment -%}
<section class="px-[6%] pb-[45px] pt-[50px] md:pb-[70px] md:pt-[80px]">
  <nav aria-label="{{ 'collections.breadcrumb' | t }}" class="eyebrow mb-[22px] md:mb-[38px]">
    <a href="{{ routes.root_url }}">{{ 'collections.home' | t }}</a>
    <span aria-hidden="true" class="mx-2">/</span>
    <span aria-current="page">{{ collection.title | upcase }}</span>
  </nav>

  <div class="grid gap-[27px] md:grid-cols-2 md:items-end md:gap-[12%]">
    <h1 class="text-[34px] leading-[1.22] md:text-[42px] md:leading-[1.17]">
      {{- collection.title -}}
      {%- if subtitle != blank -%}
        <br><em>{{ subtitle }}</em>
      {%- endif -%}
    </h1>

    <div>
      {%- if collection.description != blank and section.settings.show_description -%}
        <div class="rte max-w-[430px] text-[12px] leading-[1.95] text-ink-soft md:text-[13px]">
          {{ collection.description }}
        </div>
      {%- endif -%}
      <p class="mt-[18px] text-[9px] uppercase tracking-[1px]" role="status">
        {{ 'collections.count' | t: count: collection.products_count }}
      </p>
    </div>
  </div>
</section>

{%- if section.settings.show_image and collection.image -%}
  <div class="h-[420px] overflow-hidden md:h-[560px]">
    {{
      collection.image
      | image_url: width: 2400
      | image_tag:
        class: 'h-full w-full object-cover',
        widths: '720,1200,1600,2000,2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
    }}
  </div>
{%- endif -%}

{%- comment -%} ===================== Toolbar ===================== {%- endcomment -%}
<div class="sticky top-0 z-10 border-y border-line bg-paper/95 px-[6%] backdrop-blur-sm">
  <div class="flex items-center justify-between gap-6">
    <div
      class="-mb-px flex min-w-0 gap-[22px] overflow-x-auto whitespace-nowrap [scrollbar-width:none] md:gap-[25px] [&::-webkit-scrollbar]:hidden"
      role="navigation"
      aria-label="{{ 'sections.featured_creations.categories' | t }}"
    >
      {%- if section.settings.tabs_menu != blank -%}
        {%- for link in section.settings.tabs_menu.links -%}
          <a
            href="{{ link.url }}"
            class="filter-btn py-[18px]"
            {% if link.current or link.active %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title -}}
          </a>
        {%- endfor -%}
      {%- elsif tabs_filter -%}
        <a
          href="{{ collection.url }}?sort_by={{ sort_by }}"
          class="filter-btn py-[18px]"
          {% if tabs_filter.active_values.size == 0 %}
            aria-current="true"
          {% endif %}
        >
          {{- section.settings.all_label -}}
        </a>
        {%- for value in tabs_filter.values -%}
          {%- if value.count > 0 or value.active -%}
            <a
              href="{{ collection.url }}?{{ value.param_name }}={{ value.value | url_encode }}&sort_by={{ sort_by }}"
              class="filter-btn py-[18px]"
              {% if value.active %}
                aria-current="true"
              {% endif %}
            >
              {{- value.label -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <span class="filter-btn py-[18px]" aria-current="true">{{ section.settings.all_label }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.enable_filters or section.settings.enable_sort -%}
      <button
        type="button"
        class="shrink-0 py-[18px] text-[11px]"
        data-dialog-open="{{ drawer_id }}"
        aria-haspopup="dialog"
      >
        {{- 'collections.filter_and_sort' | t -}}
        {%- if active_count > 0 %} ({{ active_count }}){% endif %}
        <span aria-hidden="true" class="ml-1">+</span>
      </button>
    {%- endif -%}
  </div>
</div>

{%- comment -%} Filtri attivi {%- endcomment -%}
{%- if active_count > 0 -%}
  <div class="flex flex-wrap items-center gap-[10px] px-[6%] pt-[25px]">
    {%- for filter in collection.filters -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
          <a href="{{ filter.url_to_remove }}" class="rounded-full border border-pill px-4 py-2 text-[10px]">
            {{- filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}
            <span aria-hidden="true" class="ml-1">×</span>
          </a>
        {%- endif -%}
      {%- else -%}
        {%- for value in filter.active_values -%}
          <a href="{{ value.url_to_remove }}" class="rounded-full border border-pill px-4 py-2 text-[10px]">
            {{- value.label }}
            <span aria-hidden="true" class="ml-1">×</span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
    <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="ml-1 border-b border-ink pb-px text-[10px]">
      {{- 'collections.clear_all' | t -}}
    </a>
  </div>
{%- endif -%}

{%- comment -%} ===================== Griglia ===================== {%- endcomment -%}
<section class="px-[6%] pb-20 pt-[35px] md:pb-[130px] md:pt-[55px]">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="plp-grid plp-grid--{{ section.settings.columns }}{% if section.settings.staggered %} plp-grid--staggered{% endif %}">
        {%- for product in collection.products -%}
          {%- liquid
            assign card_loading = 'lazy'
            if forloop.index <= 3
              assign card_loading = 'eager'
            endif
          -%}
          {%- render 'product-card',
            product: product,
            image_class: section.settings.image_ratio,
            sizes: '(min-width: 721px) 33vw, 50vw',
            show_secondary: section.settings.show_secondary_image,
            show_badges: section.settings.show_badges,
            loading: card_loading
          -%}

          {%- comment -%} Blocchi editoriali (solo prima pagina) {%- endcomment -%}
          {%- if paginate.current_page == 1 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.after_products == forloop.parentloop.index -%}
                <aside
                  class="col-span-full my-[20px] grid grid-cols-1 bg-linen md:my-[40px] md:grid-cols-2"
                  {{ block.shopify_attributes }}
                >
                  <div class="h-[420px] overflow-hidden md:h-[560px]{% if block.settings.image_right %} md:order-2{% endif %}">
                    {%- render 'media',
                      image: block.settings.image,
                      placeholder: 'lifestyle-2',
                      class: 'h-full w-full object-cover',
                      sizes: '(min-width: 721px) 50vw, 100vw'
                    -%}
                  </div>
                  <div class="self-center px-[8%] py-[55px] md:px-[14%] md:py-[70px]">
                    {%- if block.settings.eyebrow != blank -%}
                      <p class="eyebrow mb-[27px]">{{ block.settings.eyebrow }}</p>
                    {%- endif -%}
                    <h2 class="text-[31px] leading-[1.3] md:text-[38px] md:leading-[1.17]">
                      {{- block.settings.heading -}}
                      {%- if block.settings.heading_italic != blank -%}
                        <br><em>{{ block.settings.heading_italic }}</em>
                      {%- endif -%}
                    </h2>
                    {%- if block.settings.text != blank -%}
                      <div class="rte my-[30px] max-w-[430px] leading-[1.9] text-ink-soft">{{ block.settings.text }}</div>
                    {%- endif -%}
                    {%- if block.settings.link_label != blank -%}
                      <a class="line-link mt-[10px]" href="{{ block.settings.link_url | default: routes.root_url }}">
                        {{- block.settings.link_label }} ↗
                      </a>
                    {%- endif -%}
                  </div>
                </aside>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Paginazione stile hero: ← 01 / 04 → {%- endcomment -%}
      {%- if paginate.pages > 1 -%}
        <nav
          class="mt-[80px] flex items-center justify-center gap-[20px] text-[8px] tracking-[1.2px] text-cue md:mt-[110px]"
          aria-label="{{ 'collections.pagination' | t }}"
        >
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="rounded-full px-2 py-1 text-[19px] text-ink" aria-label="{{ 'collections.previous' | t }}">←</a>
          {%- else -%}
            <span class="px-2 py-1 text-[19px] opacity-30" aria-hidden="true">←</span>
          {%- endif -%}
          <span>
            {{- paginate.current_page | prepend: '0' | slice: -2, 2 }} /
            {{ paginate.pages | prepend: '0' | slice: -2, 2 -}}
          </span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="rounded-full px-2 py-1 text-[19px] text-ink" aria-label="{{ 'collections.next' | t }}">→</a>
          {%- else -%}
            <span class="px-2 py-1 text-[19px] opacity-30" aria-hidden="true">→</span>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="py-[90px] text-center">
        <p class="eyebrow mb-[27px]">{{ collection.title | upcase }}</p>
        <h2 class="text-[29px] md:text-[35px]">{{ 'collections.empty' | t }}</h2>
        {%- if active_count > 0 -%}
          <a class="line-link mt-[35px]" href="{{ collection.url }}">{{ 'collections.clear_all' | t }} ↗</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{%- comment -%} ===================== Drawer filtri e ordinamento ===================== {%- endcomment -%}
{%- if section.settings.enable_filters or section.settings.enable_sort -%}
  <dialog
    id="{{ drawer_id }}"
    class="drawer m-0 ml-auto h-[100svh] max-h-none w-[min(440px,100vw)] max-w-none border-0 bg-paper p-0 text-ink"
    aria-labelledby="{{ drawer_id }}-title"
  >
    <form action="{{ collection.url }}" method="get" class="flex h-full flex-col">
      <div class="flex items-center justify-between border-b border-line px-[30px] py-[26px]">
        <h2 id="{{ drawer_id }}-title" class="eyebrow">{{ 'collections.filter_and_sort' | t }}</h2>
        <button type="button" class="text-[30px] leading-none" aria-label="{{ 'general.close' | t }}" data-dialog-close>×</button>
      </div>

      <div class="flex-1 overflow-y-auto px-[30px] pb-[30px]">
        {%- if section.settings.enable_sort -%}
          <details class="accordion" open>
            <summary>{{ 'collections.sort_by' | t }}</summary>
            <div class="accordion-body space-y-3">
              {%- for option in collection.sort_options -%}
                <label class="flex cursor-pointer items-center gap-3 text-ink">
                  <input
                    type="radio"
                    name="sort_by"
                    value="{{ option.value | escape }}"
                    class="h-3 w-3 accent-ink"
                    {% if option.value == sort_by %}
                      checked
                    {% endif %}
                  >
                  {{ option.name }}
                </label>
              {%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
        {%- endif -%}

        {%- if section.settings.enable_filters -%}
          {%- for filter in collection.filters -%}
            <details
              class="accordion"
              {% if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil %}
                open
              {% endif %}
            >
              <summary>
                {{- filter.label -}}
                {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
              </summary>
              <div class="accordion-body">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    <ul class="space-y-3">
                      {%- for value in filter.values -%}
                        {%- assign disabled = false -%}
                        {%- if value.count == 0 and value.active == false -%}
                          {%- assign disabled = true -%}
                        {%- endif -%}
                        <li>
                          <label class="flex cursor-pointer items-center gap-3 text-ink{% if disabled %} cursor-default opacity-40{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value | escape }}"
                              class="h-3 w-3 accent-ink"
                              {% if value.active %}
                                checked
                              {% endif %}
                              {% if disabled %}
                                disabled
                              {% endif %}
                            >
                            {%- if filter.presentation == 'swatch' and value.swatch.color -%}
                              <span
                                class="h-3 w-3 rounded-full border border-line"
                                style="background-color: {{ value.swatch.color }}"
                                aria-hidden="true"
                              ></span>
                            {%- endif -%}
                            <span>{{ value.label }}</span>
                            <span class="ml-auto text-[10px] text-muted">{{ value.count }}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>

                  {%- when 'price_range' -%}
                    <div class="grid grid-cols-2 gap-4">
                      <label>
                        <span class="field-label mt-0">{{ 'collections.price_from' | t }}</span>
                        <input
                          class="field"
                          type="number"
                          inputmode="decimal"
                          min="0"
                          step="any"
                          name="{{ filter.min_value.param_name }}"
                          {% if filter.min_value.value %}
                            value="{{ filter.min_value.value | divided_by: 100.0 }}"
                          {% endif %}
                          placeholder="0"
                        >
                      </label>
                      <label>
                        <span class="field-label mt-0">{{ 'collections.price_to' | t }}</span>
                        <input
                          class="field"
                          type="number"
                          inputmode="decimal"
                          min="0"
                          step="any"
                          name="{{ filter.max_value.param_name }}"
                          {% if filter.max_value.value %}
                            value="{{ filter.max_value.value | divided_by: 100.0 }}"
                          {% endif %}
                          placeholder="{{ filter.range_max | divided_by: 100.0 | ceil }}"
                        >
                      </label>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="flex items-center justify-between gap-4 border-t border-line px-[30px] py-[22px]">
        <a href="{{ collection.url }}" class="border-b border-ink pb-px text-[10px]">{{ 'collections.clear_all' | t }}</a>
        <button type="submit" class="btn-solid">{{ 'collections.apply' | t }}</button>
      </div>
    </form>
  </dialog>
{%- endif -%}

{% schema %}
{
  "name": "Collezione",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "header",
      "content": "Intestazione"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Seconda riga titolo (corsivo)",
      "default": "fatte a mano.",
      "info": "Sovrascrivibile per collezione con il metafield custom.sottotitolo."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostra descrizione collezione",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostra immagine collezione",
      "default": false
    },
    {
      "type": "header",
      "content": "Tab categorie"
    },
    {
      "type": "link_list",
      "id": "tabs_menu",
      "label": "Menu tab",
      "info": "Es. Tutte / Couture / Pezzi unici / Accessori (link alle collezioni). Ha la precedenza sul filtro."
    },
    {
      "type": "text",
      "id": "tabs_filter_label",
      "label": "Oppure: nome del filtro da usare come tab",
      "default": "Tipo di prodotto",
      "info": "Nome esatto del filtro in Search & Discovery."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Etichetta \"tutte\"",
      "default": "Tutte"
    },
    {
      "type": "header",
      "content": "Griglia"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Colonne (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "staggered",
      "label": "Composizione sfalsata",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporzione immagini",
      "options": [
        { "value": "aspect-[4/5]", "label": "4:5" },
        { "value": "aspect-[3/4]", "label": "3:4" },
        { "value": "aspect-[2/3]", "label": "2:3" }
      ],
      "default": "aspect-[3/4]"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Prodotti per pagina",
      "min": 6,
      "max": 36,
      "step": 6,
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Seconda immagine al passaggio del mouse",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Mostra etichette (esaurito / pezzo unico)",
      "default": true
    },
    {
      "type": "header",
      "content": "Filtri"
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Abilita filtri",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sort",
      "label": "Abilita ordinamento",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "editorial",
      "name": "Blocco editoriale",
      "limit": 3,
      "settings": [
        {
          "type": "range",
          "id": "after_products",
          "label": "Mostra dopo il prodotto n.",
          "min": 6,
          "max": 30,
          "step": 6,
          "default": 6,
          "info": "Multipli di 6, così il blocco chiude sempre una riga intera."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine"
        },
        {
          "type": "checkbox",
          "id": "image_right",
          "label": "Immagine a destra",
          "default": false
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Sopratitolo",
          "default": "SAVOIR-FAIRE"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titolo",
          "default": "Ogni pezzo"
        },
        {
          "type": "text",
          "id": "heading_italic",
          "label": "Seconda riga (corsivo)",
          "default": "racconta un tempo."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Testo pulsante",
          "default": "Scopri le tecniche"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
