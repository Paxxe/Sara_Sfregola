{%- liquid
  assign dialog_id = 'ConsultDialog-' | append: section.id
  assign form_id = 'ConsultForm-' | append: section.id
  if section.settings.dark
    assign scheme_class = 'bg-ink text-ivory'
    assign muted_class = 'text-ivory/60'
    assign button_class = 'btn-solid btn-solid--inverse'
  else
    assign scheme_class = 'bg-sand/60 text-ink'
    assign muted_class = 'text-stone'
    assign button_class = 'btn-solid'
  endif
-%}

<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="{{ scheme_class }}"
>
  <div class="page-width section-y text-center">
    <p class="eyebrow mb-8 {{ muted_class }}">
      {%- if section.settings.number != blank -%}
        {{ section.settings.number }} /
      {% endif -%}
      {{ section.settings.eyebrow }}
    </p>
    <h2 class="display-xl mx-auto max-w-4xl">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte mx-auto mt-8 max-w-lg text-base leading-relaxed opacity-75">{{ section.settings.text }}</div>
    {%- endif -%}

    <button
      type="button"
      class="{{ button_class }} mt-12"
      data-dialog-open="{{ dialog_id }}"
      aria-haspopup="dialog"
    >
      {{- section.settings.button_label }} <span aria-hidden="true">↗</span>
    </button>
  </div>
</section>

{%- comment -%} Modale con modulo di contatto Shopify {%- endcomment -%}
<dialog
  id="{{ dialog_id }}"
  class="m-auto max-h-[92svh] w-[min(680px,calc(100%-2rem))] overflow-y-auto bg-ivory p-0 text-ink"
  aria-labelledby="{{ dialog_id }}-title"
>
  <div class="relative p-8 md:p-12">
    <button
      type="button"
      class="absolute right-3 top-3 flex h-11 w-11 items-center justify-center text-2xl font-light transition-opacity hover:opacity-60"
      aria-label="{{ 'general.close' | t }}"
      data-dialog-close
    >
      ×
    </button>

    <p class="eyebrow mb-4 text-stone">{{ section.settings.eyebrow }}</p>
    <h3 id="{{ dialog_id }}-title" class="display-md mb-8">{{ section.settings.form_heading }}</h3>

    {%- form 'contact', id: form_id, class: 'grid gap-6' -%}
      {%- if form.posted_successfully? -%}
        <p class="border border-ink/15 bg-sand/50 p-4 text-sm" role="status" data-form-status>
          {{ section.settings.success_message }}
        </p>
      {%- elsif form.errors -%}
        <div class="border border-red-700/30 bg-red-50 p-4 text-sm text-red-800" role="alert" data-form-status>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Origine]" value="Consulenza privata — Home page">

      <div class="grid gap-6 md:grid-cols-2">
        <label class="block">
          <span class="field-label">{{ 'contact.name' | t }}</span>
          <input class="field" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
        </label>
        <label class="block">
          <span class="field-label">{{ 'contact.email' | t }}</span>
          <input
            class="field"
            type="email"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            value="{{ form.email }}"
            required
          >
        </label>
        <label class="block">
          <span class="field-label">{{ 'contact.phone' | t }}</span>
          <input class="field" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
        </label>
        <label class="block">
          <span class="field-label">{{ 'contact.event_date' | t }}</span>
          <input class="field" type="date" name="contact[Data evento]">
        </label>
      </div>

      {%- assign request_types = section.settings.request_types | split: ',' -%}
      {%- if request_types.size > 0 -%}
        <label class="block">
          <span class="field-label">{{ 'contact.request_type' | t }}</span>
          <select class="field" name="contact[Tipo di richiesta]">
            {%- for type in request_types -%}
              <option value="{{ type | strip | escape }}">{{ type | strip }}</option>
            {%- endfor -%}
          </select>
        </label>
      {%- endif -%}

      <label class="block">
        <span class="field-label">{{ 'contact.message' | t }}</span>
        <textarea class="field min-h-[120px] resize-y" name="contact[body]" rows="4">{{ form.body }}</textarea>
      </label>

      <button type="submit" class="btn-solid mt-2 w-full md:w-auto md:justify-self-start">
        {{- section.settings.submit_label }} <span aria-hidden="true">↗</span>
      </button>
    {%- endform -%}
  </div>
</dialog>

{% schema %}
{
  "name": "Consulenza privata",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "consulenza"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Sfondo scuro",
      "default": true
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "05"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "PRIVATE APPOINTMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Consulenza privata"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante",
      "default": "Prepara la tua richiesta"
    },
    {
      "type": "header",
      "content": "Modulo"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Titolo modulo",
      "default": "Prepara la tua richiesta"
    },
    {
      "type": "text",
      "id": "request_types",
      "label": "Tipi di richiesta",
      "default": "Abito da sposa, Abito da cerimonia, Couture su misura, Accessori, Altro",
      "info": "Separati da virgola"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Testo invio",
      "default": "Invia la richiesta"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Messaggio di conferma",
      "default": "Grazie, la tua richiesta è stata inviata. Ti ricontatteremo al più presto."
    }
  ],
  "presets": [
    {
      "name": "Consulenza privata"
    }
  ]
}
{% endschema %}
