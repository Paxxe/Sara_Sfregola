<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="atelier-story"
>
  <div class="atelier-story__images">
    <figure class="atelier-story__portrait">
      {%- render 'media',
        image: section.settings.image,
        placeholder: 'lifestyle-1',
        class: 'h-full w-full object-cover',
        sizes: '(min-width: 721px) 38vw, 80vw'
      -%}
    </figure>
    {%- if section.settings.detail_image != blank -%}
      <figure class="atelier-story__detail">
        {%- render 'media',
          image: section.settings.detail_image,
          class: 'block h-auto w-full',
          sizes: '(min-width: 721px) 20vw, 40vw'
        -%}
      </figure>
    {%- endif -%}
  </div>

  <div class="min-w-0">
    <h2 class="editorial-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.lead != blank -%}
      <p class="atelier-story__lead">{{ section.settings.lead }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte atelier-story__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="line-link mt-[30px]" href="{{ section.settings.link_url | default: routes.root_url }}">
        {{- section.settings.link_label }} ↗
      </a>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="atelier-story__chapter" {{ block.shopify_attributes }}>
        <h3 class="atelier-story__chapter-title">{{ block.settings.heading }}</h3>
        {%- if block.settings.text != blank -%}
          <div class="rte atelier-story__text">{{ block.settings.text }}</div>
        {%- endif -%}
        {%- if block.settings.link_label != blank -%}
          <a class="line-link mt-[24px]" href="{{ block.settings.link_url | default: routes.root_url }}">
            {{- block.settings.link_label }} ↗
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Storia atelier",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "storia"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Ritratto"
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Immagine di dettaglio (sovrapposta)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "La stilista"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Testo introduttivo (grande)"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo pulsante",
      "default": "Scopri le tecniche"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Capitolo",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titolo",
          "default": "La scuola"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Testo pulsante"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Storia atelier",
      "category": "Editoriale",
      "blocks": [
        { "type": "chapter", "settings": { "heading": "La scuola" } },
        { "type": "chapter", "settings": { "heading": "Mostre e riconoscimenti" } }
      ]
    }
  ]
}
{% endschema %}
