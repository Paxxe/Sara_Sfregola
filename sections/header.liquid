<site-header class="relative block text-ink">
  <div class="flex h-[86px] items-center justify-between px-[5%] md:h-[108px] md:px-[3%]">
    <a href="{{ routes.root_url }}" class="flex h-16 w-[73px] items-center md:h-[78px] md:w-[88px]">
      {%- render 'logo',
        class: 'h-full w-full object-contain brightness-0',
        text_class: 'items-start text-left text-[15px] lg:text-[21px] whitespace-nowrap',
        sizes: '88px'
      -%}
    </a>

    {%- if section.settings.menu.links.size > 0 -%}
      <nav
        id="SiteNav-{{ section.id }}"
        aria-label="{{ 'header.main_nav' | t }}"
        class="absolute inset-x-0 top-[86px] z-10 hidden flex-col gap-[25px] bg-paper p-[25px] text-[10px] uppercase tracking-[1px] shadow-[0_15px_30px_#0001] data-[open]:flex md:static md:flex md:flex-row md:gap-[21px] md:bg-transparent md:p-0 md:shadow-none lg:gap-[38px]"
        data-nav
      >
        {%- for link in section.settings.menu.links -%}
          <a
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title -}}
          </a>
        {%- endfor -%}
      </nav>

      <div class="flex items-center gap-3 text-[10px] md:gap-4">
        <button
          type="button"
          class="block md:hidden"
          aria-expanded="false"
          aria-controls="SiteNav-{{ section.id }}"
          aria-label="{{ 'header.open_menu' | t }}"
          data-label-open="{{ 'header.open_menu' | t }}"
          data-label-close="{{ 'header.close_menu' | t }}"
          data-menu-toggle
        >
          ☰
        </button>
      </div>
    {%- endif -%}
  </div>
</site-header>

{% schema %}
{
  "name": "Header",
  "class": "header-wrapper",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "paragraph",
      "content": "In homepage l'header è trasparente e sovrapposto all'hero."
    }
  ]
}
{% endschema %}
