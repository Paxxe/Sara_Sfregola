<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="craft"
>
  <div class="craft__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow mb-[27px]">
        {%- if section.settings.number != blank -%}
          {{ section.settings.number }} /
        {% endif -%}
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}
    <h2 class="editorial-title">{{ section.settings.heading }}</h2>

    {%- if section.settings.text != blank -%}
      <div class="rte editorial-text my-[30px]">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="mt-[30px]">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="!text-[14px]">{{ block.settings.title }}</summary>
          <div class="accordion-body">
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="line-link mt-4 text-ink" href="{{ block.settings.link_url | default: routes.root_url }}">
                {{- block.settings.link_label }} ↗
              </a>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  <div class="craft__media">
    {%- if section.settings.video != blank -%}
      {{-
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: true,
          preload: 'metadata',
          image_size: '1600x',
          class: 'absolute inset-0 h-full w-full object-cover'
      -}}
    {%- else -%}
      {%- render 'media',
        image: section.settings.image,
        placeholder: 'detailed-apparel-1',
        class: 'absolute inset-0 h-full w-full object-cover',
        sizes: '(min-width: 721px) 60vw, 100vw'
      -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Savoir-faire",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "savoir-faire"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Se presente sostituisce l’immagine. Parte in automatico, muto e in loop."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "SAVOIR-FAIRE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Le tecniche artigianali"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    }
  ],
  "blocks": [
    {
      "type": "technique",
      "name": "Tecnica",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nome tecnica",
          "default": "Tombolo"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Descrizione"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Testo pulsante",
          "default": "Scopri la tecnica"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Savoir-faire",
      "blocks": [
        { "type": "technique", "settings": { "title": "Tombolo" } },
        { "type": "technique", "settings": { "title": "Chiacchierino" } },
        { "type": "technique", "settings": { "title": "Macramè" } },
        { "type": "technique", "settings": { "title": "Altre tecniche", "link_label": "Scopri le altre tecniche" } }
      ],
      "category": "Editoriale"
    }
  ]
}
{% endschema %}
