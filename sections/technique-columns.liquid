{%- liquid
  assign column_count = 0
  assign image_count = 0
  for block in section.blocks
    if block.type == 'column'
      assign column_count = column_count | plus: 1
    else
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}

<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="tech-cols"
>
  <div class="tech-cols__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="tech-cols__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if column_count > 0 -%}
      <div class="tech-cols__grid" style="--cols: {{ column_count | at_most: 4 }};">
        {%- for block in section.blocks -%}
          {%- if block.type == 'column' -%}
            <article {{ block.shopify_attributes }} id="{{ block.settings.title | handleize }}">
              <h3 class="tech-cols__title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <div class="rte tech-cols__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if image_count > 0 -%}
    <div class="tech-cols__strip" style="--imgs: {{ image_count }};">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          <div class="tech-cols__strip-item" {{ block.shopify_attributes }}>
            {%- render 'media',
              image: block.settings.image,
              placeholder: 'detailed-apparel-1',
              class: 'absolute inset-0 h-full w-full object-cover',
              sizes: '(min-width: 721px) 25vw, 50vw'
            -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Altre tecniche (colonne)",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "altre-tecniche"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Altre tecniche"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Tecnica",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nome tecnica",
          "default": "Merletto rinascimentale"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo"
        }
      ]
    },
    {
      "type": "image",
      "name": "Immagine striscia",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Altre tecniche (colonne)",
      "category": "Editoriale",
      "blocks": [
        { "type": "column", "settings": { "title": "Merletto rinascimentale" } },
        { "type": "column", "settings": { "title": "Uncinetto tradizionale" } },
        { "type": "column", "settings": { "title": "Sperimentazioni" } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
