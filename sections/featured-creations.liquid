{%- liquid
  assign featured = section.settings.collection
  assign has_products = false
  if featured != blank and featured.products_count > 0
    assign has_products = true
  endif
-%}

<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="px-[6%] pb-20 pt-[15px] md:pb-[130px] md:pt-[30px]"
>
  <product-filter class="block">
    <div class="mb-[22px] md:flex md:items-end md:justify-between">
      <div>
        <p class="eyebrow mb-[22px]">
          {%- if section.settings.number != blank -%}
            {{ section.settings.number }} /
          {% endif -%}
          <span>{{ section.settings.eyebrow }}</span>
        </p>
        <h2 class="text-[29px] md:text-[35px]">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.side_text != blank -%}
        <span class="mt-5 block text-[9px] leading-[1.8] tracking-[1px] md:mt-0">{{ section.settings.side_text }}</span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div
        role="group"
        aria-label="{{ 'sections.featured_creations.categories' | t }}"
        class="mb-[35px] mt-[25px] flex gap-[22px] md:mb-[55px] md:gap-[25px]"
      >
        <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">
          {{- section.settings.all_label -}}
        </button>
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="filter-btn"
            data-filter="{{ block.settings.tag | handleize }}"
            aria-pressed="false"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="creations-grid" data-grid>
      {%- if has_products -%}
        {%- for product in featured.products limit: section.settings.products_to_show -%}
          {%- capture product_tags -%}
            {%- for tag in product.tags -%}{{ tag | handleize }} {% endfor -%}
            {{- product.type | handleize -}}
          {%- endcapture -%}
          {%- render 'product-card', product: product, tags: product_tags -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Segnaposto come nella bozza: un pezzo per categoria {%- endcomment -%}
        {%- assign placeholder_titles = section.settings.placeholder_titles | split: ',' -%}
        {%- for i in (0..2) -%}
          {%- liquid
            assign placeholder_tags = section.blocks[i].settings.tag | handleize
            assign placeholder_title = placeholder_titles[i] | strip
          -%}
          {%- render 'product-card', title: placeholder_title, tags: placeholder_tags -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <p class="py-[35px] text-muted" data-empty hidden>{{ 'sections.featured_creations.empty' | t }}</p>
  </product-filter>
</section>

{% schema %}
{
  "name": "Creazioni in evidenza",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "creazioni"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "01"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "LE CREAZIONI"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Creazioni"
    },
    {
      "type": "text",
      "id": "side_text",
      "label": "Testo laterale"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Prodotti da mostrare",
      "info": "La composizione asimmetrica si ripete ogni 3 prodotti.",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 3
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Etichetta filtro \"tutte\"",
      "default": "Tutte"
    },
    {
      "type": "text",
      "id": "placeholder_titles",
      "label": "Titoli segnaposto",
      "default": "Creazione 01, Creazione 02, Accessorio",
      "info": "Usati finché non scegli una collezione. Separati da virgola."
    },
    {
      "type": "paragraph",
      "content": "Le ore di manifattura vengono lette dal metafield prodotto custom.ore_manifattura (numero intero)."
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtro categoria",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etichetta",
          "default": "Couture"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag o tipo prodotto",
          "default": "couture",
          "info": "Mostra i prodotti con questo tag (o tipo prodotto)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Creazioni in evidenza",
      "blocks": [
        { "type": "filter", "settings": { "label": "Couture", "tag": "couture" } },
        { "type": "filter", "settings": { "label": "Pezzi unici", "tag": "unique" } },
        { "type": "filter", "settings": { "label": "Accessori", "tag": "accessories" } }
      ]
    }
  ]
}
{% endschema %}
