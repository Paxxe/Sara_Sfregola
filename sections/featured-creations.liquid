{%- liquid
  assign featured = section.settings.collection
  assign has_products = false
  if featured != blank and featured.products_count > 0
    assign has_products = true
  endif
-%}

<section
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
  class="page-width section-y border-t border-ink/10"
>
  <product-filter class="block">
    <div class="mb-12 flex flex-col gap-6 md:mb-16 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow mb-6 text-stone">
          {%- if section.settings.number != blank -%}
            {{ section.settings.number }} /
          {% endif -%}
          <span class="text-ink">{{ section.settings.eyebrow }}</span>
        </p>
        <h2 class="display-lg">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.side_text != blank -%}
        <p class="max-w-xs text-sm leading-relaxed text-stone md:text-right">{{ section.settings.side_text }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div
        role="group"
        aria-label="{{ 'sections.featured_creations.categories' | t }}"
        class="mb-10 flex flex-wrap gap-x-8 gap-y-3 md:mb-14"
      >
        <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">
          {{- section.settings.all_label -}}
        </button>
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="filter-btn"
            data-filter="{{ block.settings.tag | handleize }}"
            aria-pressed="false"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="grid grid-cols-1 gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8">
      {%- if has_products -%}
        {%- for product in featured.products limit: section.settings.products_to_show -%}
          {%- capture product_tags -%}
            {%- for tag in product.tags -%}{{ tag | handleize }} {% endfor -%}
            {{- product.type | handleize -}}
          {%- endcapture -%}
          {%- render 'product-card', product: product, tags: product_tags -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Segnaposto: un prodotto per ogni categoria filtro {%- endcomment -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign block_index = i | minus: 1
            assign placeholder_tags = section.blocks[block_index].settings.tag | handleize
          -%}
          {%- render 'product-card', index: i, tags: placeholder_tags -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <p class="mt-10 text-sm text-stone" data-empty hidden>
      {{- 'sections.featured_creations.empty' | t -}}
    </p>

    {%- if section.settings.view_all_label != blank -%}
      <div class="mt-16 text-center">
        <a
          class="line-link"
          href="{% if has_products %}{{ featured.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        >
          {{- section.settings.view_all_label }} <span aria-hidden="true">↗</span>
        </a>
      </div>
    {%- endif -%}
  </product-filter>
</section>

{% schema %}
{
  "name": "Creazioni in evidenza",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancora (id)",
      "default": "creazioni"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Numero sezione",
      "default": "01"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "LE CREAZIONI"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Creazioni"
    },
    {
      "type": "text",
      "id": "side_text",
      "label": "Testo laterale"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Prodotti da mostrare",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Etichetta filtro \"tutte\"",
      "default": "Tutte"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Testo link \"vedi tutte\"",
      "default": "Vedi tutte le creazioni"
    },
    {
      "type": "paragraph",
      "content": "Le ore di manifattura vengono lette dal metafield prodotto custom.ore_manifattura (numero intero)."
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtro categoria",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etichetta",
          "default": "Couture"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag o tipo prodotto",
          "default": "couture",
          "info": "Mostra i prodotti con questo tag (o tipo prodotto)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Creazioni in evidenza",
      "blocks": [
        { "type": "filter", "settings": { "label": "Couture", "tag": "couture" } },
        { "type": "filter", "settings": { "label": "Pezzi unici", "tag": "pezzi-unici" } },
        { "type": "filter", "settings": { "label": "Accessori", "tag": "accessori" } }
      ]
    }
  ]
}
{% endschema %}
