{%- comment -%}
  Pannello megamenu desktop.

  Parametri:
  - link: voce di primo livello del menu
  - mega: blocco "megamenu" del header (opzionale) con fino a 2 immagini
  - panel_id: id del pannello (aria-controls)
{%- endcomment -%}
{%- liquid
  assign has_grandchildren = false
  for child in link.links
    if child.links.size > 0
      assign has_grandchildren = true
      break
    endif
  endfor

  assign promo_count = 0
  if mega
    if mega.settings.image_1 != blank or mega.settings.title_1 != blank
      assign promo_count = promo_count | plus: 1
    endif
    if mega.settings.image_2 != blank or mega.settings.title_2 != blank
      assign promo_count = promo_count | plus: 1
    endif
  endif
-%}
<div
  id="{{ panel_id }}"
  class="mega absolute inset-x-0 top-full z-30 hidden border-t border-line bg-paper normal-case tracking-normal text-ink data-[open]:block"
  data-mega-panel
>
  <div class="grid grid-cols-12 gap-6 px-[3%] pb-[55px] pt-[45px] lg:gap-8">
    {%- comment -%} Colonne di link {%- endcomment -%}
    <div class="{% if promo_count > 0 %}col-span-7{% else %}col-span-12{% endif %} flex flex-col">
      <p class="eyebrow mb-[27px] text-muted">{{ link.title }}</p>

      {%- if link.links.size > 0 -%}
        {%- if has_grandchildren -%}
          <div class="grid gap-x-6 gap-y-[35px] {% if promo_count > 0 %}grid-cols-3{% else %}grid-cols-4{% endif %}">
            {%- for child in link.links -%}
              <div>
                <a
                  href="{{ child.url }}"
                  class="eyebrow mb-[18px] block"
                  {% if child.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- child.title -}}
                </a>
                {%- if child.links.size > 0 -%}
                  <ul class="space-y-[10px] text-[13px]">
                    {%- for grandchild in child.links -%}
                      <li>
                        <a
                          href="{{ grandchild.url }}"
                          {% if grandchild.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- grandchild.title -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- comment -%} Solo secondo livello: lista editoriale a caratteri grandi {%- endcomment -%}
          <ul class="space-y-[6px]">
            {%- for child in link.links -%}
              <li>
                <a
                  href="{{ child.url }}"
                  class="text-[28px] leading-[1.3] tracking-[-0.8px] lg:text-[34px]"
                  {% if child.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- child.title -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}

      <div class="mt-auto pt-[40px]">
        <a href="{{ link.url }}" class="line-link">{{ 'header.discover_all' | t }} ↗</a>
      </div>
    </div>

    {%- comment -%} Immagini {%- endcomment -%}
    {%- if promo_count > 0 -%}
      <div class="col-span-5 grid gap-6 {% if promo_count == 2 %}grid-cols-2{% else %}grid-cols-1{% endif %}" {{ mega.shopify_attributes }}>
        {%- for i in (1..2) -%}
          {%- liquid
            assign image_key = 'image_' | append: i
            assign eyebrow_key = 'eyebrow_' | append: i
            assign title_key = 'title_' | append: i
            assign link_key = 'link_' | append: i
            assign promo_image = mega.settings[image_key]
            assign promo_title = mega.settings[title_key]
          -%}
          {%- if promo_image != blank or promo_title != blank -%}
            <a href="{{ mega.settings[link_key] | default: link.url }}" class="group block">
              <div class="{% if promo_count == 2 %}aspect-[4/5]{% else %}aspect-[5/4]{% endif %} overflow-hidden bg-mist">
                {%- render 'media',
                  image: promo_image,
                  placeholder: 'lifestyle-1',
                  class: 'h-full w-full object-cover',
                  sizes: '(min-width: 1001px) 20vw, 25vw'
                -%}
              </div>
              <div class="mt-3 border-t border-line pt-3">
                {%- if mega.settings[eyebrow_key] != blank -%}
                  <p class="eyebrow mb-1 text-muted">{{ mega.settings[eyebrow_key] }}</p>
                {%- endif -%}
                {%- if promo_title != blank -%}
                  <p class="flex items-center justify-between text-[13px]">
                    {{ promo_title }} <span aria-hidden="true">↗</span>
                  </p>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
