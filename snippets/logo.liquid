{%- comment -%}
  Logo del brand: immagine dalle impostazioni tema o fallback testuale.

  Parametri:
  - image: immagine alternativa (opzionale)
  - class: classi per l'immagine
  - text_class: classi per il fallback testuale (allineamento e dimensione)
  - sizes: attributo sizes (opzionale)
{%- endcomment -%}
{%- liquid
  assign logo_image = image | default: settings.logo
  assign logo_sizes = sizes | default: '200px'
-%}
{%- if logo_image != blank -%}
  {{-
    logo_image
    | image_url: width: 600
    | image_tag: class: class, widths: '150,300,450,600', sizes: logo_sizes, alt: shop.name
  -}}
{%- else -%}
  <span class="flex flex-col leading-none {{ text_class | default: 'items-center text-center' }}">
    <span class="tracking-[3px]">{{ shop.name }}</span>
    {%- if settings.logo_tagline != blank -%}
      <span class="mt-[0.5em] text-[0.38em] uppercase tracking-[2.8px]">{{ settings.logo_tagline }}</span>
    {%- endif -%}
  </span>
{%- endif -%}
