{%- comment -%}
  Card prodotto della griglia "Creazioni".
  Proporzioni e posizione arrivano dalla griglia .creations-grid (ciclo di 3).

  Parametri:
  - product: oggetto prodotto (se assente viene mostrato un segnaposto)
  - tags: stringa di tag handleizzati separati da spazio (per i filtri)
  - title: titolo del segnaposto
{%- endcomment -%}
{%- liquid
  if product
    assign card_url = product.url
    assign card_title = product.title
    assign hours = product.metafields.custom.ore_manifattura.value
  else
    assign card_url = routes.all_products_collection_url
    assign card_title = title
  endif
-%}
<a href="{{ card_url }}" class="product block w-full text-left" data-product data-tags="{{ tags | strip }}">
  <div class="product-image relative overflow-hidden bg-mist">
    {%- if product.featured_media -%}
      {{-
        product.featured_media
        | image_url: width: 1400
        | image_tag:
          class: 'block h-full w-full object-cover',
          widths: '400,600,800,1000,1400',
          sizes: '(min-width: 721px) 50vw, 75vw',
          loading: 'lazy'
      -}}
    {%- else -%}
      {{- 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' -}}
    {%- endif -%}
  </div>

  <div class="mt-3 flex items-center justify-between border-t border-line pt-[10px] md:mt-[17px] md:pt-3">
    <h3 class="text-[12px] font-normal md:text-[13px]">{{ card_title }}</h3>
    <span aria-hidden="true">↗</span>
  </div>

  <p class="mt-[9px] text-[8px] leading-[1.8] tracking-[0.3px] text-muted md:text-[9px]">
    {%- if product -%}
      {%- if hours != blank -%}
        {{ 'sections.featured_creations.hours' | t: count: hours }} ·
      {% endif -%}
      {{ product.price | money }}
    {%- else -%}
      {{ 'sections.featured_creations.placeholder_meta' | t }}
    {%- endif -%}
  </p>
</a>
