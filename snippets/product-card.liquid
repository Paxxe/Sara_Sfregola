{%- comment -%}
  Card prodotto (homepage "Creazioni" e PLP).

  Parametri:
  - product: oggetto prodotto (se assente viene mostrato un segnaposto)
  - tags: stringa di tag handleizzati separati da spazio (filtri homepage)
  - title: titolo del segnaposto
  - image_class: classi aggiuntive per il riquadro immagine (es. 'aspect-[3/4]')
  - sizes: attributo sizes delle immagini
  - show_secondary: mostra la seconda immagine al passaggio del mouse
  - show_badges: mostra etichette (esaurito, pezzo unico)
  - loading: 'eager' per le prime card
{%- endcomment -%}
{%- liquid
  assign card_sizes = sizes | default: '(min-width: 721px) 50vw, 75vw'
  assign card_loading = loading | default: 'lazy'
  if product
    assign card_url = product.url
    assign card_title = product.title
    assign hours = product.metafields.custom.ore_manifattura.value
    assign secondary = nil
    if show_secondary and product.media.size > 1
      assign secondary = product.media[1]
    endif
  else
    assign card_url = routes.all_products_collection_url
    assign card_title = title
  endif
-%}
<a
  href="{{ card_url }}"
  class="product group block w-full text-left"
  data-product
  {% if tags != blank %}
    data-tags="{{ tags | strip }}"
  {% endif %}
>
  <div class="product-image relative overflow-hidden bg-mist {{ image_class }}">
    {%- if product.featured_media -%}
      {{-
        product.featured_media
        | image_url: width: 1400
        | image_tag:
          class: 'block h-full w-full object-cover',
          widths: '400,600,800,1000,1400',
          sizes: card_sizes,
          loading: card_loading
      -}}
      {%- if secondary -%}
        {{-
          secondary
          | image_url: width: 1400
          | image_tag:
            class: 'absolute inset-0 block h-full w-full object-cover opacity-0 transition-opacity duration-700 group-hover:opacity-100',
            widths: '400,600,800,1000,1400',
            sizes: card_sizes,
            loading: 'lazy',
            alt: ''
        -}}
      {%- endif -%}
    {%- else -%}
      {{- 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' -}}
    {%- endif -%}

    {%- if product and show_badges -%}
      {%- liquid
        assign badge = ''
        if product.available == false
          assign badge = 'products.sold_out' | t
        elsif product.tags contains 'pezzo-unico' or product.tags contains 'unique'
          assign badge = 'products.unique_piece' | t
        endif
      -%}
      {%- if badge != blank -%}
        <span class="absolute left-2 top-[9px] bg-paper/90 px-[6px] py-[6px] text-[6px] uppercase tracking-[1px] md:left-[17px] md:top-[18px] md:px-[9px] md:py-[7px] md:text-[8px]">
          {{- badge -}}
        </span>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="mt-3 flex items-center justify-between gap-3 border-t border-line pt-[10px] md:mt-[17px] md:pt-3">
    <h3 class="text-[12px] font-normal md:text-[13px]">{{ card_title }}</h3>
    <span aria-hidden="true">↗</span>
  </div>

  <p class="mt-[9px] text-[8px] leading-[1.8] tracking-[0.3px] text-muted md:text-[9px]">
    {%- if product -%}
      {%- if hours != blank -%}
        {{ 'sections.featured_creations.hours' | t: count: hours }} ·
      {% endif -%}
      {%- if product.price_varies -%}
        {%- assign price_min = product.price_min | money -%}
        {{ 'products.from_price' | t: price: price_min }}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
      {%- if product.compare_at_price > product.price %}
        <s class="ml-1 opacity-60">{{ product.compare_at_price | money }}</s>
      {%- endif -%}
    {%- else -%}
      {{ 'sections.featured_creations.placeholder_meta' | t }}
    {%- endif -%}
  </p>
</a>
