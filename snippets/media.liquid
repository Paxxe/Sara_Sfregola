{%- comment -%}
  Immagine responsive con placeholder Shopify quando non è impostata.

  Parametri:
  - image: oggetto immagine (opzionale)
  - placeholder: nome placeholder_svg_tag (default 'image')
  - class: classi CSS
  - sizes: attributo sizes (default 100vw)
  - priority: true per l'immagine LCP (eager + fetchpriority high)
{%- endcomment -%}
{%- liquid
  assign media_sizes = sizes | default: '100vw'
  assign media_placeholder = placeholder | default: 'image'
  assign placeholder_class = 'placeholder-svg ' | append: class
-%}
{%- if image != blank -%}
  {%- if priority -%}
    {{-
      image
      | image_url: width: 2400
      | image_tag:
        class: class,
        sizes: media_sizes,
        widths: '480,720,960,1200,1600,2000,2400',
        loading: 'eager',
        fetchpriority: 'high'
    -}}
  {%- else -%}
    {{-
      image
      | image_url: width: 2400
      | image_tag:
        class: class,
        sizes: media_sizes,
        widths: '480,720,960,1200,1600,2000,2400',
        loading: 'lazy'
    -}}
  {%- endif -%}
{%- else -%}
  {{- media_placeholder | placeholder_svg_tag: placeholder_class -}}
{%- endif -%}
